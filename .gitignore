# IDE / editor
.vscode/
# Keep root workspace automation tracked:
!/.vscode/
!/.vscode/**
/.vscode/c_cpp_properties.json
/.vscode/jaszczurhal.library.local.json
!examples/*/.vscode/
!examples/*/.vscode/**
examples/*/.vscode/jaszczurhal.local.json
examples/*/.vscode/c_cpp_properties.json
examples/18_freertos_suite/ca_certificate.h
# Keep hardware project manifests tracked, but ignore per-user VS Code state.
!tests/hardware/*/.vscode/
tests/hardware/*/.vscode/*
!tests/hardware/*/.vscode/jaszczurhal.project.json
# Keep the Phase 3 compile fixture's target/board contract tracked as well.
!tests/fixtures/esp32s3_phase3/.vscode/
tests/fixtures/esp32s3_phase3/.vscode/*
!tests/fixtures/esp32s3_phase3/.vscode/jaszczurhal.project.json
# Keep the Classic gamepad compile fixture's target/board selection tracked.
!tests/fixtures/esp32_gamepad/.vscode/
tests/fixtures/esp32_gamepad/.vscode/*
!tests/fixtures/esp32_gamepad/.vscode/jaszczurhal.project.json
