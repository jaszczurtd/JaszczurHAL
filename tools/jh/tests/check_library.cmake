cmake_minimum_required(VERSION 3.22)
# The library commands of jh: target list and facts against the tracked
# board registry (read here with string(JSON), independent of jh), the build
# directory key of a device tree library, the selection and output errors of
# library build that stop before any process or write, library install
# without CMake install rules and library inspect of a package fixture.
# Building real libraries needs the SDKs: the library-* stages of the gate.
if(NOT EXISTS "${JH}" OR NOT IS_DIRECTORY "${JH_HAL_SOURCE}/boards")
  message(FATAL_ERROR "jh_library needs JH and JH_HAL_SOURCE")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/cli_helpers.cmake")
# contains() for messages that name paths: jh writes \ on Windows.
function(contains_path text fragment what)
  slashed(text "${text}")
  slashed(fragment "${fragment}")
  contains("${text}" "${fragment}" "${what}")
endfunction()
file(REMOVE_RECURSE "${JH_WORK}")
file(MAKE_DIRECTORY "${JH_WORK}/cwd")
# The checkout the runners named with cd .. && pwd: no . or .. segments.
get_filename_component(root "${JH_HAL_SOURCE}" ABSOLUTE)

# The registry facts the library runners read, from the target descriptors.
file(GLOB descriptors LIST_DIRECTORIES false "${root}/boards/targets/*.json")
list(SORT descriptors)
set(expected_list "")
set(ids "")
foreach(descriptor IN LISTS descriptors)
  file(READ "${descriptor}" json)
  string(JSON id GET "${json}" id)
  string(JSON provider GET "${json}" build provider)
  string(JSON state GET "${json}" status)
  string(JSON board GET "${json}" defaultBoard)
  string(JSON isa GET "${json}" architecture isa)
  list(APPEND ids "${id}")
  if(provider MATCHES "^(pico-sdk|jh-stm32-baremetal|esp-idf)$")
    string(APPEND expected_list "${id} ${provider} ${state}\n")
  endif()
  set(features "")
  string(JSON count ERROR_VARIABLE missing LENGTH "${json}" supportedFeatures)
  if(NOT missing AND count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON feature GET "${json}" supportedFeatures ${index})
      string(REGEX REPLACE "=1$" "" feature "${feature}")
      list(APPEND features "${feature}")
    endforeach()
  endif()
  string(REPLACE ";" " " features "${features}")
  invoke(0 target facts --root "${root}" --target "${id}")
  set(expected "provider=${provider}\ndefaultBoard=${board}\nisa=${isa}\nstatus=${state}\nsupportedFeatures=${features}\n")
  if(NOT stdout STREQUAL expected)
    message(FATAL_ERROR "target facts ${id}:\n${stdout}\nexpected:\n${expected}")
  endif()
  invoke(0 target facts --root "${root}" --target "${id}" --json)
  status(HAL_OK)
  string(JSON value GET "${stdout}" provider)
  if(NOT value STREQUAL provider)
    message(FATAL_ERROR "target facts --json ${id}: provider ${value}")
  endif()
endforeach()
list(SORT ids)
string(REPLACE ";" ", " known "${ids}")
invoke(0 target list --root "${root}")
if(NOT stdout STREQUAL expected_list)
  message(FATAL_ERROR "target list:\n${stdout}\nexpected:\n${expected_list}")
endif()
lacks("${stdout}" "mock" "target list without the host provider")
invoke(2 target facts --root "${root}" --target nope)
contains("${stderr}" "unknown target 'nope'; known targets: ${known}" "unknown target")
invoke(2 target facts --root "${root}" --target=)
contains("${stderr}" "unknown target ''; known targets: " "empty target")
invoke(2 target facts --root "${root}")
contains("${stderr}" "target facts requires --target" "missing target")

# The build directory key: requests in any order give one key; the
# directory names one resolved path, also through . and .. and a trailing
# separator; every request and the assembly change it.
set(config "${JH_WORK}/configs/a b ż")
file(MAKE_DIRECTORY "${config}/inner")
invoke(0 library key --config-dir "${config}" --request=variant= --request=all=1 --request=freertos=1)
set(base "${stdout}")
if(NOT base MATCHES "^auto/[0-9a-f]+\n$")
  message(FATAL_ERROR "library key format: ${base}")
endif()
string(LENGTH "${base}" length)
if(NOT length EQUAL 22)
  message(FATAL_ERROR "library key length: ${base}")
endif()
invoke(0 library key --config-dir "${config}/inner/.." --request=freertos=1 --request=variant= --request=all=1)
if(NOT stdout STREQUAL base)
  message(FATAL_ERROR "library key of an alias: ${stdout} vs ${base}")
endif()
invoke(0 library key --config-dir "${config}/" --request=all=1 --request=freertos=1 --request=variant=)
if(NOT stdout STREQUAL base)
  message(FATAL_ERROR "library key with a trailing separator: ${stdout} vs ${base}")
endif()
file(RELATIVE_PATH relative "${JH_WORK}/cwd" "${config}")
invoke(0 library key --config-dir "${relative}" --request=variant= --request=all=1 --request=freertos=1)
if(NOT stdout STREQUAL base)
  message(FATAL_ERROR "library key of a relative directory: ${stdout} vs ${base}")
endif()
foreach(change "--request=variant=X;--request=all=1;--request=freertos=1"
               "--request=variant=;--request=all=0;--request=freertos=1"
               "--request=variant=;--request=all=1;--request=freertos=1;--request=HAL_ENABLE_CRC=1")
  invoke(0 library key --config-dir "${config}" ${change})
  if(stdout STREQUAL base)
    message(FATAL_ERROR "library key ignores a request: ${change}")
  endif()
endforeach()
invoke(0 library key --config-dir "${config}" --assembly picow --request=variant= --request=all=1 --request=freertos=1)
if(NOT stdout MATCHES "^picow/[0-9a-f]+\n$" OR stdout STREQUAL base)
  message(FATAL_ERROR "library key of an assembly: ${stdout}")
endif()
if(NOT CMAKE_HOST_WIN32)
  # Values of scripts/device_tree_project.py build_key for the root directory.
  invoke(0 library key --config-dir / --request=variant=)
  if(NOT stdout STREQUAL "auto/6323f4961fe826fe\n")
    message(FATAL_ERROR "library key of /: ${stdout}")
  endif()
  invoke(0 library key --config-dir / --assembly picow --request=variant= --request=freertos=1 --request=all=1)
  if(NOT stdout STREQUAL "picow/c696efb8e941046f\n")
    message(FATAL_ERROR "library key of / with picow: ${stdout}")
  endif()
endif()
invoke(0 library key --config-dir "${config}" --json)
status(HAL_OK)
invoke(2 library key)
contains("${stderr}" "library key requires --config-dir" "missing config dir")

# Errors library build reports before it starts a process or writes.
set(fixture "${root}/tests/fixtures/device_tree/hal/library")
invoke(2 library build --root "${root}")
contains("${stderr}" "library build requires --target" "missing target")
invoke(1 library build --root "${root}" --target nope)
contains("${stderr}" "Unknown target 'nope'" "unknown target")
invoke(1 library build --root "${root}" --target mock)
contains("${stderr}" "Target 'mock' (provider 'host') has no linkable-library runner" "host target")
invoke(2 library build --root "${root}" --target rp2040 --board picow --project-config "${fixture}")
contains_path("${stderr}" "[JH-HW-BOARD] ${fixture}/device_tree.json selects the board" "board with a device tree")
invoke(2 library build --root "${root}" --target stm32g474 --assembly x)
contains("${stderr}" "[JH-HW-ASSEMBLY] --assembly and --variant need -p DIR with device_tree.json" "assembly without a device tree")
invoke(2 library build --root "${root}" --target rp2040 --variant X)
contains("${stderr}" "[JH-HW-ASSEMBLY]" "variant without a device tree")
invoke(1 library build --root "${root}" --target rp2040 --output "${root}/tests/outside")
contains_path("${stderr}" "Build output must be inside ${root}/.build" "output outside .build")
invoke(1 library build --root "${root}" --target stm32g474 --output ../outside)
contains_path("${stderr}" "Build output must be inside ${root}/.build" "relative output outside .build")
# A relative output resolves below the checkout: inside .build it passes, so
# the STM32 build stops later at its missing toolchain file; elsewhere it
# fails first.
invoke(1 library build --root "${root}" --target stm32g474 --output .build/custom/test
  "--toolchain=${JH_WORK}/missing toolchain.cmake")
contains_path("${stderr}" "Toolchain file not found: ${JH_WORK}/missing toolchain.cmake" "accepted output")
invoke(1 library build --root "${root}" --target stm32g474 --output build_legacy
  "--toolchain=${JH_WORK}/missing toolchain.cmake")
contains_path("${stderr}" "Build output must be inside ${root}/.build" "output outside .build")
invoke(1 library build --root "${root}" --target rp2040 --define HAL_ENABLE_WIFI=0)
contains("${stderr}" "[JH-CFG-VALUE] HAL_ENABLE_WIFI=0 is unsupported; use a standalone bare symbol or an explicit value of 1" "define value")
invoke(1 library build --root "${root}" --target stm32g474 "--define=$<1:HAL_ENABLE_CRC>")
contains("${stderr}" "generator expressions are not accepted" "generator expression")
invoke(1 library build --root "${root}" --target rp2040 --example ../x)
contains("${stderr}" "Example must be a directory name under examples/: ../x" "example name")
invoke(1 library build --root "${root}" --target rp2040 --example 01_core_runtime --library-only)
contains("${stderr}" "--library-only cannot be combined with --example" "example with library-only")
invoke(1 library build --root "${root}" --target rp2040 --picotool-build-dir "${root}/tests/picotool")
contains_path("${stderr}" "picotool build output must be inside ${root}/.build" "picotool output")

# Install needs the CMake install rules of a configured build.
file(MAKE_DIRECTORY "${JH_WORK}/not-configured")
invoke(2 library install --build-dir "${JH_WORK}/not-configured" --prefix "${JH_WORK}/prefix")
contains("${stderr}" "has no CMake install rules" "install without rules")
invoke(2 library install --prefix "${JH_WORK}/prefix")
contains("${stderr}" "library install requires --build-dir" "install without build dir")

# Inspect lists the files of a package with their SHA-256 and the identity
# its device tree record states.
set(package "${JH_WORK}/package ż")
invoke(2 library inspect --prefix "${package}")
contains("${stderr}" "is not a library package: lib/libJaszczurHAL.a is missing" "inspect without archive")
file(WRITE "${package}/lib/libJaszczurHAL.a" "!<arch>\n")
file(WRITE "${package}/include/generated/jh_board_config.h" "#pragma once\n")
file(WRITE "${package}/share/JaszczurHAL/generated/jh_hardware_config.cmake"
  "set(JH_CONFIG_SHA256 \"c0ffee\")\nset(JH_HARDWARE_SHA256 \"beef\")\nset(JH_HARDWARE_ABI \"lp64\")\n")
invoke(0 library inspect --prefix "${package}")
set(expected "kind=device-tree\nJH_CONFIG_SHA256=c0ffee\nJH_HARDWARE_SHA256=beef\nJH_HARDWARE_ABI=lp64\n")
foreach(file IN ITEMS include/generated/jh_board_config.h lib/libJaszczurHAL.a
                      share/JaszczurHAL/generated/jh_hardware_config.cmake)
  file(SHA256 "${package}/${file}" digest)
  string(APPEND expected "${digest}  ${file}\n")
endforeach()
if(NOT stdout STREQUAL expected)
  message(FATAL_ERROR "library inspect:\n${stdout}\nexpected:\n${expected}")
endif()
invoke(0 library inspect --prefix "${package}" --json)
status(HAL_OK)
string(JSON kind GET "${stdout}" kind)
string(JSON count LENGTH "${stdout}" files)
if(NOT kind STREQUAL "device-tree" OR NOT count EQUAL 3)
  message(FATAL_ERROR "library inspect --json: ${stdout}")
endif()
message(STATUS "jh library commands passed")
