cmake_minimum_required(VERSION 3.22)
# Keep reports outside suite fixtures: those directories are recreated by
# each test. Audit even a failed suite and never infer memory safety from its
# exit status; CLI tests deliberately accept nonzero application statuses.
foreach(required JH_BUILD JH_WRAPPER JH_CTEST JH_REPORTS)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
execute_process(COMMAND "${JH_CTEST}" --test-dir "${JH_BUILD}" -C "${JH_CONFIG}"
    --show-only=json-v1 -L "^cli$"
  OUTPUT_VARIABLE inventory COMMAND_ERROR_IS_FATAL ANY)
string(JSON count LENGTH "${inventory}" tests)
set(required_suites jh_cli jh_features jh_boards jh_schema_compat jh_device_defaults)
if(count GREATER 0)
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    string(JSON name GET "${inventory}" tests ${index} name)
    list(REMOVE_ITEM required_suites "${name}")
  endforeach()
endif()
if(required_suites)
  message(FATAL_ERROR "Missing CLI memory suites: ${required_suites}")
endif()
file(REMOVE_RECURSE "${JH_REPORTS}")
file(MAKE_DIRECTORY "${JH_REPORTS}")
set(ENV{JH_TEST_REPORTS} "${JH_REPORTS}")
set(ENV{JH_TEST_WRAPPER} "${JH_WRAPPER}")
if(JH_VALGRIND)
  set(ENV{JH_TEST_VALGRIND} "${JH_VALGRIND}")
else()
  unset(ENV{JH_TEST_VALGRIND})
  set(ENV{ASAN_OPTIONS} "$ENV{ASAN_OPTIONS}:detect_leaks=1:halt_on_error=1:hard_rss_limit_mb=2048:log_path=${JH_REPORTS}/asan")
  set(ENV{UBSAN_OPTIONS} "$ENV{UBSAN_OPTIONS}:halt_on_error=1:log_path=${JH_REPORTS}/ubsan")
endif()
# Suites own separate fixtures; PID-specific reports can be written together.
# Limit concurrency to two CLI invocations with the test memory ceilings.
execute_process(COMMAND "${JH_CTEST}" --test-dir "${JH_BUILD}" -C "${JH_CONFIG}"
    --output-on-failure --no-tests=error -L "^cli$" --parallel 2
  RESULT_VARIABLE result TIMEOUT 7200)
file(GLOB markers "${JH_REPORTS}/run.*")
list(LENGTH markers executions)
if(executions EQUAL 0)
  message(FATAL_ERROR "No CLI invocation reached the memory checker")
endif()
if(JH_VALGRIND)
  foreach(marker IN LISTS markers)
    get_filename_component(pid "${marker}" NAME)
    string(REPLACE "run." "" pid "${pid}")
    set(report "${JH_REPORTS}/valgrind.${pid}.xml")
    if(NOT EXISTS "${report}")
      message(FATAL_ERROR "Missing Valgrind report for ${marker}")
    endif()
    file(READ "${report}" xml)
    if(NOT xml MATCHES "<state>FINISHED</state>" OR xml MATCHES "<error>")
      message(FATAL_ERROR "Memory defect or incomplete CLI execution: ${report}")
    endif()
  endforeach()
else()
  file(GLOB failures "${JH_REPORTS}/asan.*" "${JH_REPORTS}/ubsan.*")
  if(failures)
    message(FATAL_ERROR "CLI sanitizer reports: ${failures}")
  endif()
endif()
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "CLI memory suites failed: ${result}")
endif()
message(STATUS "CLI memory checks: ${executions} invocations; reports in ${JH_REPORTS}")
