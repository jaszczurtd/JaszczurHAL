{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "libraryBoardSelection",
            "description": "JaszczurHAL library target/board",
            "type": "pickString",
            "options": [
                "esp32:esp32-devkitc-v4 - Espressif ESP32-DevKitC V4 (experimental)",
                "esp32s3:waveshare-esp32-s3-zero - Waveshare ESP32-S3-Zero SKU 25081",
                "mock:host-mock - Host mock board",
                "rp2040:pico - Raspberry Pi Pico",
                "rp2040:picow - Raspberry Pi Pico W",
                "rp2040:rp2040-lora-lf - Waveshare RP2040-LoRa-LF (experimental)",
                "rp2040:rp2040-plus-4mb - Waveshare RP2040-Plus 4 MB",
                "rp2040:rp2040-zero - Waveshare RP2040-Zero compatible",
                "rp2350-arm:pico2 - Raspberry Pi Pico 2",
                "rp2350-arm:pico2w - Raspberry Pi Pico 2 W",
                "rp2350-arm:rp2350-plus-4mb - Waveshare RP2350-Plus 4 MB",
                "rp2350-riscv:pico2 - Raspberry Pi Pico 2",
                "rp2350-riscv:rp2350-plus-4mb - Waveshare RP2350-Plus 4 MB",
                "stm32g474:nucleo-g474re - ST NUCLEO-G474RE"
            ],
            "default": "rp2040:pico - Raspberry Pi Pico"
        },
        {
            "id": "libraryConfigDir",
            "description": "Configuration directory with device_tree.json and hal_project_config.h",
            "type": "promptString"
        }
    ],
    "tasks": [
        {
            "label": "Project: Build",
            "detail": "Ctrl+Shift+1 - build the active linkable JaszczurHAL library",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/vscode_library_workspace.py",
                "build"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Project: Refresh IntelliSense",
            "detail": "Ctrl+Shift+6 - build the active profile and select its compile database",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/vscode_library_workspace.py",
                "refresh-intellisense"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Clean",
            "detail": "Ctrl+Shift+7 - remove only the active library build and install trees",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/vscode_library_workspace.py",
                "clean"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Project: Install library",
            "detail": "Ctrl+Shift+0 - install the active archive, headers, and link contract",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/vscode_library_workspace.py",
                "install"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Select board (GUI)",
            "detail": "Ctrl+Shift+Alt+1 - select the active library target and board",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/vscode_library_workspace.py",
                "select",
                "--selection",
                "${input:libraryBoardSelection}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Project: Select board",
            "detail": "Ctrl+Shift+Alt+2 - select the active library target and board in the terminal",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/vscode_library_workspace.py",
                "select",
                "--interactive"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Library: Select device tree configuration",
            "detail": "Select an assembly and variant of a configuration directory with device_tree.json",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/vscode_library_workspace.py",
                "select",
                "--config-dir",
                "${input:libraryConfigDir}",
                "--interactive"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Library: Show active profile",
            "detail": "Print the active target, board, build paths, and install paths",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/vscode_library_workspace.py",
                "config-dump"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Install git hooks",
            "type": "shell",
            "command": "chmod +x .githooks/pre-commit .githooks/commit-msg && git config core.hooksPath .githooks",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "close": true
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": []
        }
    ]
}
