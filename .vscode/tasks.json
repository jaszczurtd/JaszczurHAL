{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install git hooks",
            "type": "shell",
            "command": "chmod +x .githooks/pre-commit .githooks/commit-msg && git config core.hooksPath .githooks",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "close": true
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": []
        }
    ]
}
