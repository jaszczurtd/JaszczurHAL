{
    "jaszczurhal.buildDir": "${workspaceFolder}/../../.build/examples/10_storage",
    "jaszczurhal.verbose": false,
    "jaszczurhal.root": "../..",
    "jaszczurhal.vscodeEntry": "../../vscode/entry/jh-vscode",
    "jaszczurhal.vscodeEntryWindows": "../../vscode/entry/jh-vscode.cmd",
    "cortex-debug.gdbPath.linux": "gdb-multiarch",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/../../.build/examples/10_storage/compile_commands_patched.json",
    "C_Cpp.errorSquiggles": "enabled",
    "cmake.sourceDirectory": "${workspaceFolder}/../../cmake/jh_firmware_project",
    "cmake.buildDirectory": "${workspaceFolder}/../../.build/examples/10_storage/cmake-tools/rp2040-pico",
    "cmake.generator": "Ninja",
    "cmake.configureSettings": {
        "JH_TARGET": "rp2040",
        "PICO_SDK_PATH": "${workspaceFolder}/../../third_party/pico-sdk",
        "JH_BOARD": "pico",
        "JH_ARTIFACT_DIR": "${workspaceFolder}/../../.build/examples/10_storage",
        "JH_PROJECT_DIR": "${workspaceFolder}",
        "JH_MODULE_NAME": "10_storage",
        "JH_ROOT": "${workspaceFolder}/../.."
    },
    "files.exclude": {
        "**/.build": true
    },
    "search.exclude": {
        "**/.build": true
    }
}
