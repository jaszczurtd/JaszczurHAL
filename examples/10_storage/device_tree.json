{
  "$schema": "../../config/hardware/device_tree.schema.json",
  "schemaVersion": 1,
  "nodes": {
    "sd": {
      "compatible": "jaszczurhal,spi-device"
    }
  },
  "assemblies": {
    "pico": {
      "target": "rp2040",
      "board": "pico",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed" },
      "buses": {
        "spi": {
          "kind": "spi",
          "index": 0,
          "frequencyHz": 12000000,
          "pins": { "sck": 18, "mosi": 19, "miso": 16 }
        }
      },
      "nodes": {
        "sd": { "present": true, "bus": "spi", "pins": { "cs": 17 } }
      }
    },
    "pico2-arm": {
      "target": "rp2350-arm",
      "board": "pico2",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed" },
      "buses": {
        "spi": {
          "kind": "spi",
          "index": 0,
          "frequencyHz": 12000000,
          "pins": { "sck": 18, "mosi": 19, "miso": 16 }
        }
      },
      "nodes": {
        "sd": { "present": true, "bus": "spi", "pins": { "cs": 17 } }
      }
    },
    "pico2-riscv": {
      "target": "rp2350-riscv",
      "board": "pico2",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed" },
      "buses": {
        "spi": {
          "kind": "spi",
          "index": 0,
          "frequencyHz": 12000000,
          "pins": { "sck": 18, "mosi": 19, "miso": 16 }
        }
      },
      "nodes": {
        "sd": { "present": true, "bus": "spi", "pins": { "cs": 17 } }
      }
    },
    "nucleo": {
      "target": "stm32g474",
      "board": "nucleo-g474re",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed" },
      "buses": {
        "spi": {
          "kind": "spi",
          "index": 0,
          "frequencyHz": 12000000,
          "pins": { "sck": "PB3", "mosi": "PA7", "miso": "PA6" }
        }
      },
      "nodes": {
        "sd": { "present": true, "bus": "spi", "pins": { "cs": "PB6" } }
      }
    }
  }
