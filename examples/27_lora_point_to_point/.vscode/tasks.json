{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "boardSelection",
            "description": "Select an assembly of device_tree.json",
            "type": "pickString",
            "options": [
                "nucleo-core1262-hf - stm32g474/nucleo-g474re",
                "pico-core1262-hf - rp2040/pico",
                "rp2040-lora-lf - rp2040/rp2040-lora-lf"
            ],
            "default": "pico-core1262-hf - rp2040/pico"
        }
    ],
    "tasks": [
        {
            "label": "Project: Build",
            "detail": "Build firmware for the selected board.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "build",
                "--project",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Build (Debug)",
            "detail": "Build firmware with debug settings.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "build-debug",
                "--project",
                "${workspaceFolder}"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Upload",
            "detail": "Upload firmware to the selected board.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "upload",
                "--project",
                "${workspaceFolder}"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Upload (UF2 / BOOTSEL)",
            "detail": "RP2040 only: build firmware and copy its UF2 file to the only detected BOOTSEL drive.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "upload-uf2",
                "--project",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Project: Upload (OTA)",
