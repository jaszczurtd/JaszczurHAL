{
    "$schema": "../../../vscode/schema/jh_vscode_project.schema.json",
    "project": "JaszczurHAL examples",
    "module": "27_lora_point_to_point",
    "example": {
        "targets": [
            "rp2040",
            "stm32g474"
        ],
        "boards": {
            "rp2040": "pico-core1262-hf",
            "stm32g474": "nucleo-g474re-core1262-hf"
        },
        "gateTargets": [
            "rp2040",
            "stm32g474"
        ],
        "variants": [
            {
                "id": "probe",
                "module": "27_lora_point_to_point_probe",
                "targets": [
                    "rp2040",
                    "stm32g474"
                ],
                "extraDefines": [
                    "HAL_LORA_EXAMPLE_PROBE_ONLY=1"
                ],
                "gateTargets": [
                    "rp2040",
                    "stm32g474"
                ]
            },
            {
                "id": "responder",
                "module": "27_lora_point_to_point_responder",
                "targets": [
                    "rp2040",
                    "stm32g474"
                ],
                "extraDefines": [
                    "HAL_LORA_EXAMPLE_RESPONDER=1"
                ],
                "gateTargets": [
                    "rp2040",
                    "stm32g474"
                ]
            },
            {
                "id": "sf7",
                "module": "27_lora_point_to_point_sf7",
                "targets": [
                    "rp2040",
                    "stm32g474"
                ],
                "gateTargets": [],
                "extraDefines": [
                    "HAL_LORA_EXAMPLE_SF=7",
                    "HAL_LORA_EXAMPLE_TX_POWER_DBM=6"
                ]
            },
            {
                "id": "responder-sf7",
                "module": "27_lora_point_to_point_responder_sf7",
                "targets": [
                    "rp2040",
                    "stm32g474"
                ],
                "gateTargets": [],
                "extraDefines": [
                    "HAL_LORA_EXAMPLE_RESPONDER=1",
                    "HAL_LORA_EXAMPLE_SF=7",
                    "HAL_LORA_EXAMPLE_TX_POWER_DBM=6"
                ]
            },
            {
                "id": "link",
                "module": "27_lora_point_to_point_link",
                "sources": [
                    "link_app.cpp"
                ],
                "targets": [
                    "rp2040",
                    "stm32g474"
                ],
                "extraDefines": [
                    "HAL_ENABLE_LORA_LINK=1"
                ],
                "gateTargets": [
                    "rp2040",
                    "stm32g474"
                ]
            },
            {
                "id": "link-responder",
                "module": "27_lora_point_to_point_link_responder",
                "sources": [
                    "link_app.cpp"
                ],
                "targets": [
                    "rp2040",
                    "stm32g474"
                ],
                "extraDefines": [
                    "HAL_ENABLE_LORA_LINK=1",
                    "HAL_LORA_LINK_EXAMPLE_RESPONDER=1"
                ],
                "gateTargets": [
                    "rp2040",
                    "stm32g474"
                ]
            }
        ]
    },
    "toolchain": "cmake",
    "target": "rp2040",
    "board": "pico-core1262-hf",
    "buildDir": "${jhRoot}/.build/examples/27_lora_point_to_point",
    "cmakeBuildDir": "${buildDir}/cmake",
    "cmake": {
        "sourceDir": "${project}/../../cmake/jh_firmware_project",
        "cache": {
            "JH_ARTIFACT_DIR": "${buildDir}",
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "27_lora_point_to_point"
        }
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2",
        "compileCommands": "${buildDir}/compile_commands_patched.json"
    }
}
