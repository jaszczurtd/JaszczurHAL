{
    "$schema": "../../../vscode/schema/jh_vscode_project.schema.json",
    "project": "JaszczurHAL examples",
    "module": "29_bluetooth_gamepad",
    "example": {
        "targets": [
            "rp2040",
            "rp2350-arm",
            "stm32g474"
        ],
        "boards": {
            "rp2040": "picow",
            "rp2350-arm": "pico2w",
            "stm32g474": "nucleo-g474re-pim730"
        },
        "gateTargets": [
            "rp2040"
        ],
        "variants": [
            {
                "id": "classic-scan",
                "module": "29_bluetooth_classic_scan",
                "sources": [
                    "classic_scan_app.c"
                ],
                "targets": [
                    "rp2040",
                    "rp2350-arm",
                    "stm32g474"
                ],
                "gateTargets": [
                    "rp2040"
                ],
                "extraDefines": [
                    "HAL_ENABLE_BLUETOOTH_CLASSIC=1"
                ]
            },
            {
                "id": "hid-host",
                "module": "29_bluetooth_hid_host",
                "sources": [
                    "hid_host_app.c"
                ],
                "targets": [
                    "rp2040",
                    "rp2350-arm",
                    "stm32g474"
                ],
                "gateTargets": [
                    "rp2040"
                ],
                "extraDefines": [
                    "HAL_ENABLE_BLUETOOTH_HID_HOST=1"
                ]
            },
            {
                "id": "ble",
                "module": "29_bluetooth_gamepad_ble",
                "targets": [
                    "rp2040",
                    "rp2350-arm",
                    "stm32g474"
                ],
                "gateTargets": [
                    "rp2040"
                ],
                "extraDefines": [
                    "HAL_ENABLE_BLE=1",
                    "HAL_ENABLE_BLUETOOTH_GAMEPAD=1",
                    "HAL_GAMEPAD_EXAMPLE_ENABLE_BLE=1"
                ]
            }
        ]
    },
    "toolchain": "cmake",
    "target": "rp2040",
    "board": "picow",
    "buildDir": "${jhRoot}/.build/examples/29_bluetooth_gamepad",
    "cmakeBuildDir": "${buildDir}/cmake",
    "cmake": {
        "sourceDir": "${project}/../../cmake/jh_firmware_project",
        "cache": {
            "JH_ARTIFACT_DIR": "${buildDir}",
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "29_bluetooth_gamepad",
            "JH_PROJECT_SOURCES": "app.c",
            "JH_EXTRA_DEFINES": "HAL_ENABLE_BLUETOOTH_GAMEPAD=1"
        }
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2",
        "compileCommands": "${buildDir}/compile_commands_patched.json"
    }
}
