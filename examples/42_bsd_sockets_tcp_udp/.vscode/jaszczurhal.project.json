{
    "$schema": "../../../vscode/schema/jh_vscode_project.schema.json",
    "project": "JaszczurHAL examples",
    "module": "42_bsd_sockets_tcp_server",
    "example": {
        "targets": [
            "stm32g474",
            "rp2040",
            "rp2350-arm"
        ],
        "boards": {
            "rp2040": "picow",
            "rp2350-arm": "pico2w",
            "stm32g474": "nucleo-g474re-pim730"
        },
        "variants": [
            {
                "id": "tcp_client",
                "module": "42_bsd_sockets_tcp_client",
                "sources": [
                    "tcp_client.c",
                    "bsd_socket_example_common.h"
                ],
                "targets": [
                    "stm32g474",
                    "rp2040",
                    "rp2350-arm"
                ]
            },
            {
                "id": "udp_server",
                "module": "42_bsd_sockets_udp_server",
                "sources": [
                    "udp_server.c",
                    "bsd_socket_example_common.h"
                ],
                "targets": [
                    "stm32g474",
                    "rp2040",
                    "rp2350-arm"
                ]
            },
            {
                "id": "udp_client",
                "module": "42_bsd_sockets_udp_client",
                "sources": [
                    "udp_client.c",
                    "bsd_socket_example_common.h"
                ],
                "targets": [
                    "stm32g474",
                    "rp2040",
                    "rp2350-arm"
                ]
            }
        ]
    },
    "toolchain": "cmake",
    "target": "rp2040",
    "board": "picow",
    "buildDir": "${jhRoot}/.build/examples/42_bsd_sockets_tcp_udp",
    "cmakeBuildDir": "${buildDir}/cmake",
    "cmake": {
        "sourceDir": "${project}/../../cmake/jh_firmware_project",
        "cache": {
            "JH_ARTIFACT_DIR": "${buildDir}",
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "42_bsd_sockets_tcp_server",
            "JH_PROJECT_SOURCES": "tcp_server.c;bsd_socket_example_common.h"
        }
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2",
        "compileCommands": "${buildDir}/compile_commands_patched.json"
    }
}
