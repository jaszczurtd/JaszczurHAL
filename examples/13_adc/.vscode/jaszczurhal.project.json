{
    "$schema": "../../../vscode/schema/jh_vscode_project.schema.json",
    "project": "JaszczurHAL examples",
    "module": "13_adc",
    "example": {
        "targets": [
            "stm32g474",
            "esp32s3",
            "rp2040",
            "rp2350-arm",
            "rp2350-riscv"
        ],
        "boards": {
            "rp2040": "pico",
            "rp2350-arm": "pico2",
            "rp2350-riscv": "pico2",
            "stm32g474": "nucleo-g474re",
            "esp32s3": "waveshare-esp32-s3-zero"
        },
        "gateTargets": [
            "stm32g474",
            "esp32s3",
            "rp2040"
        ],
        "variants": [
            {
                "id": "scan",
                "module": "13_adc_scan",
                "sources": [
                    "scan_app.c"
                ],
                "targets": [
                    "stm32g474",
                    "esp32s3",
                    "rp2040",
                    "rp2350-arm",
                    "rp2350-riscv"
                ],
                "extraDefines": [
                    "HAL_ENABLE_ADC_SCAN=1"
                ],
                "gateTargets": [
                    "stm32g474",
                    "esp32s3",
                    "rp2040"
                ]
            }
        ]
    },
    "toolchain": "cmake",
    "target": "rp2040",
    "board": "pico",
    "buildDir": "${jhRoot}/.build/examples/13_adc",
    "cmakeBuildDir": "${buildDir}/cmake",
    "cmake": {
        "sourceDir": "${project}/../../cmake/jh_firmware_project",
        "cache": {
            "JH_ARTIFACT_DIR": "${buildDir}",
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "13_adc",
            "JH_PROJECT_SOURCES": "app.c"
        }
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2",
        "compileCommands": "${buildDir}/compile_commands_patched.json"
    }
}
