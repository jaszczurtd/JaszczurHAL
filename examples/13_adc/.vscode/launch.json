{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Project: Debug pico (RP2040)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/../../.build/examples/13_adc/rp2040/pico/firmware.elf",
            "servertype": "openocd",
            "device": "RP2040",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Project: Build (Debug) pico",
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ]
        },
