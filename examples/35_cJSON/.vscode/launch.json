{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Project: Debug Firmware",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/../../.build/examples/35_cJSON/firmware.elf",
            "servertype": "openocd",
            "device": "RP2040",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Project: Build (Debug)"
        },
        {
            "name": "Project: Debug Firmware (RP2350 ARM)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/../../.build/examples/35_cJSON/firmware.elf",
            "servertype": "openocd",
            "device": "RP2350",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Project: Build (Debug)"
        }
    ]
}
