{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Project: Debug picow (RP2040)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/../../.build/examples/30_bluetooth_speaker/rp2040/picow/firmware.elf",
            "servertype": "openocd",
            "device": "RP2040",
            "configFiles": [
