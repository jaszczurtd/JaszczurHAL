{
    "$schema": "../../../vscode/schema/jh_vscode_project.schema.json",
    "project": "JaszczurHAL examples",
    "module": "30_bluetooth_speaker",
    "example": {
        "targets": [
            "rp2040",
            "rp2350-arm"
        ],
        "boards": {
            "rp2040": "picow",
            "rp2350-arm": "pico2w"
        },
        "gateTargets": [
            "rp2040",
            "rp2350-arm"
        ],
        "variants": [
            {
                "id": "avrcp",
                "module": "30_bluetooth_speaker_avrcp",
                "gateTargets": [
                    "rp2040",
                    "rp2350-arm"
                ],
                "extraDefines": [
                    "HAL_ENABLE_BLUETOOTH_AVRCP_TARGET=1"
                ],
                "targets": [
                    "rp2040",
                    "rp2350-arm"
                ]
            },
            {
                "id": "ble-a2dp",
                "module": "30_bluetooth_speaker_ble_a2dp",
                "gateTargets": [
                    "rp2040",
                    "rp2350-arm"
                ],
                "extraDefines": [
                    "HAL_ENABLE_BLE=1",
                    "HAL_SPEAKER_EXAMPLE_ENABLE_BLE=1"
                ],
                "targets": [
                    "rp2040",
                    "rp2350-arm"
                ]
            }
        ]
    },
    "toolchain": "cmake",
    "target": "rp2040",
    "board": "picow",
    "buildDir": "${jhRoot}/.build/examples/30_bluetooth_speaker",
    "cmakeBuildDir": "${buildDir}/cmake",
    "cmake": {
        "sourceDir": "${project}/../../cmake/jh_firmware_project",
        "cache": {
            "JH_ARTIFACT_DIR": "${buildDir}",
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "30_bluetooth_speaker",
            "JH_PROJECT_SOURCES": "app.c"
        }
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2",
        "compileCommands": "${buildDir}/compile_commands_patched.json"
    }
}
