{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "boardSelection",
            "description": "Select an assembly of device_tree.json",
            "type": "pickString",
            "options": [
                "pico2w - rp2350-arm/pico2w",
                "picow - rp2040/picow"
            ],
            "default": "picow - rp2040/picow"
        }
    ],
    "tasks": [
        {
            "label": "Project: Build",
            "detail": "Build firmware for the selected board.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "build",
                "--project",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Build (Debug)",
            "detail": "Build firmware with debug settings.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "build-debug",
                "--project",
                "${workspaceFolder}"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Upload",
            "detail": "Upload firmware to the selected board.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "upload",
                "--project",
                "${workspaceFolder}"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Upload (UF2 / BOOTSEL)",
            "detail": "RP2040 only: build firmware and copy its UF2 file to the only detected BOOTSEL drive.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "upload-uf2",
                "--project",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Project: Upload (OTA)",
            "detail": "Build firmware, authenticate, and upload it to one RP device discovered on the network.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "upload-ota",
                "--project",
                "${workspaceFolder}",
                "--interactive"
            ],
            "problemMatcher": []
        },
        {
            "label": "Project: Discover OTA devices",
            "detail": "List JaszczurHAL devices available for native OTA updates.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "ota-discover",
                "--project",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Project: List ports",
            "detail": "List serial ports, matching device identities, and possible BOOTSEL drives.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "list-ports",
                "--project",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Project: Change port",
            "detail": "Select and save the serial port used for uploads and monitoring.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "change-port",
                "--project",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Project: Serial Monitor",
            "detail": "Open the project's persistent serial monitor.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "monitor",
                "--project",
                "${workspaceFolder}",
                "--lock-policy",
                "replace-own"
            ],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Project: Debug Probe Monitor",
            "detail": "Monitor serial output through the Debug Probe.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "monitor-probe",
                "--project",
                "${workspaceFolder}",
                "--lock-policy",
                "replace-own"
            ],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Project: Serial Monitor (Any)",
            "detail": "Monitor output from any serial port.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "monitor-any",
                "--project",
                "${workspaceFolder}",
                "--lock-policy",
                "wait"
            ],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Project: Refresh IntelliSense",
            "detail": "Update IntelliSense data for this project's sources.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "refresh-intellisense",
                "--project",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Project: Clean",
            "detail": "Remove the project's build files.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "clean",
                "--project",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Project: Clear USB Identity",
            "detail": "Replace the installed application with neutral firmware after verifying the USB device identity.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "clear-identity",
                "--project",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Project: Config Dump",
            "detail": "Show the effective project configuration.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "config-dump",
                "--project",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Project: Select board",
            "detail": "Choose an assembly of device_tree.json (it fixes target and board) in the interactive selector.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "select-board",
                "--project",
                "${workspaceFolder}",
                "--interactive"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Project: Select board (GUI)",
            "detail": "Choose an assembly of device_tree.json (it fixes target and board) from the VS Code menu.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "select-board",
                "--project",
                "${workspaceFolder}",
                "--selection",
                "${input:boardSelection}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Project: Sync board picker",
            "detail": "Update the board-selection list and managed debug configurations.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "sync-board-picker",
                "--project",
                "${workspaceFolder}"
            ],
            "runOptions": {
                "runOn": "folderOpen",
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "never",
                "panel": "shared",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "Project: Build variant: AVRCP",
            "detail": "Build the AVRCP variant: A2DP speaker with AVRCP volume control.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "build",
                "--project",
                "${workspaceFolder}",
                "--variant",
                "AVRCP"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Upload variant: AVRCP",
            "detail": "Build and upload the AVRCP variant: A2DP speaker with AVRCP volume control.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "upload",
                "--project",
                "${workspaceFolder}",
                "--variant",
                "AVRCP"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Build variant: BLE_A2DP",
            "detail": "Build the BLE_A2DP variant: A2DP speaker with BLE and Classic support in one image.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "build",
                "--project",
                "${workspaceFolder}",
                "--variant",
                "BLE_A2DP"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Upload variant: BLE_A2DP",
            "detail": "Build and upload the BLE_A2DP variant: A2DP speaker with BLE and Classic support in one image.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "upload",
                "--project",
                "${workspaceFolder}",
                "--variant",
                "BLE_A2DP"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Check device tree",
            "detail": "Check every assembly of device_tree.json after each save and list the problems at their place in the file.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "check-hardware",
                "--project",
                "${workspaceFolder}",
                "--watch"
            ],
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen",
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "never",
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "problemMatcher": {
                "owner": "jaszczurhal-device-tree",
                "source": "device_tree.json",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+): (error|warning): (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^jh-vscode check-hardware: checking ",
                    "endsPattern": "^jh-vscode check-hardware: (no problems|\\d+ problems?)$"
                }
            }
        },
        {
            "label": "Project: Build (Debug) pico2w",
            "detail": "Build the pico2w assembly with debug settings for its debug profile.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "build-debug",
                "--project",
                "${workspaceFolder}",
                "--assembly",
                "pico2w"
            ],
            "hide": true,
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Build (Debug) pico2w variant: AVRCP",
            "detail": "Build the pico2w assembly, variant AVRCP, with debug settings for its debug profile.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "build-debug",
                "--project",
                "${workspaceFolder}",
                "--assembly",
                "pico2w",
                "--variant",
                "AVRCP"
            ],
            "hide": true,
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Build (Debug) pico2w variant: BLE_A2DP",
            "detail": "Build the pico2w assembly, variant BLE_A2DP, with debug settings for its debug profile.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "build-debug",
                "--project",
                "${workspaceFolder}",
                "--assembly",
                "pico2w",
                "--variant",
                "BLE_A2DP"
            ],
            "hide": true,
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Build (Debug) picow",
            "detail": "Build the picow assembly with debug settings for its debug profile.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "build-debug",
                "--project",
                "${workspaceFolder}",
                "--assembly",
                "picow"
            ],
            "hide": true,
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Build (Debug) picow variant: AVRCP",
            "detail": "Build the picow assembly, variant AVRCP, with debug settings for its debug profile.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "build-debug",
                "--project",
                "${workspaceFolder}",
                "--assembly",
                "picow",
                "--variant",
                "AVRCP"
            ],
            "hide": true,
            "problemMatcher": "$gcc"
        },
        {
            "label": "Project: Build (Debug) picow variant: BLE_A2DP",
            "detail": "Build the picow assembly, variant BLE_A2DP, with debug settings for its debug profile.",
            "type": "shell",
            "command": "${config:jaszczurhal.vscodeEntry}",
            "windows": {
                "command": "${config:jaszczurhal.vscodeEntryWindows}"
            },
            "args": [
                "build-debug",
                "--project",
                "${workspaceFolder}",
                "--assembly",
                "picow",
                "--variant",
                "BLE_A2DP"
            ],
            "hide": true,
            "problemMatcher": "$gcc"
        }
    ]
}
