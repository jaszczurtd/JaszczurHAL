{
  "$schema": "../../config/hardware/device_tree.schema.json",
  "schemaVersion": 1,
  "nodes": {
    "pcf8563": { "compatible": "jaszczurhal,i2c-device" },
    "ds3231": { "compatible": "jaszczurhal,i2c-device" },
    "display": {
      "compatible": "ilitek,ili9341",
      "properties": { "width": 240, "height": 320, "rotation": 90 }
    }
  },
  "assemblies": {
    "pico": {
      "target": "rp2040",
      "board": "pico",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed" },
      "buses": {
        "i2c": {
          "kind": "i2c",
          "index": 0,
          "frequencyHz": 400000,
          "pins": { "sda": 4, "scl": 5 }
        }
      },
      "nodes": {
        "pcf8563": { "present": true, "bus": "i2c", "address": 81 },
        "ds3231": { "present": true, "bus": "i2c", "address": 104 },
        "display": { "present": false }
      }
    },
    "pico2-arm": {
      "target": "rp2350-arm",
      "board": "pico2",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed" },
      "buses": {
        "i2c": {
          "kind": "i2c",
          "index": 0,
          "frequencyHz": 400000,
          "pins": { "sda": 4, "scl": 5 }
        }
      },
      "nodes": {
        "pcf8563": { "present": true, "bus": "i2c", "address": 81 },
        "ds3231": { "present": true, "bus": "i2c", "address": 104 },
        "display": { "present": false }
      }
    },
    "pico2-riscv": {
      "target": "rp2350-riscv",
      "board": "pico2",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed" },
      "buses": {
        "i2c": {
          "kind": "i2c",
          "index": 0,
          "frequencyHz": 400000,
          "pins": { "sda": 4, "scl": 5 }
        }
      },
      "nodes": {
        "pcf8563": { "present": true, "bus": "i2c", "address": 81 },
        "ds3231": { "present": true, "bus": "i2c", "address": 104 },
        "display": { "present": false }
      }
    },
    "nucleo": {
      "target": "stm32g474",
      "board": "nucleo-g474re",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed" },
      "buses": {
        "i2c": {
          "kind": "i2c",
          "index": 0,
          "frequencyHz": 400000,
          "pins": { "sda": "PB9", "scl": "PB8" }
        },
        "spi": {
          "kind": "spi",
          "index": 0,
          "frequencyHz": 24000000,
          "pins": { "sck": "PB3", "mosi": "PA7", "miso": "PA6" }
        }
      },
      "nodes": {
        "pcf8563": { "present": true, "bus": "i2c", "address": 81 },
        "ds3231": { "present": true, "bus": "i2c", "address": 104 },
        "display": {
          "present": true,
          "bus": "spi",
          "transport": { "frequencyHz": 24000000 },
          "pins": { "cs": "PB6", "dc": "PC7", "reset": "PA9" }
        }
      }
    }
  }
}
