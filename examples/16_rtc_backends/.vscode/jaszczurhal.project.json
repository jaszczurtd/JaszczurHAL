{
    "$schema": "../../../vscode/schema/jh_vscode_project.schema.json",
    "project": "JaszczurHAL examples",
    "module": "16_rtc_backends",
    "example": {
        "targets": [
            "stm32g474",
            "rp2040",
            "rp2350-arm",
            "rp2350-riscv"
        ],
        "boards": {
            "rp2040": "pico",
            "rp2350-arm": "pico2",
            "rp2350-riscv": "pico2",
            "stm32g474": "nucleo-g474re"
        },
        "gateTargets": [
            "stm32g474",
            "rp2040"
        ],
        "variants": [
            {
                "id": "display-clock",
                "module": "16_rtc_display_clock",
                "sources": [
                    "display_clock_app.cpp"
                ],
                "targets": [
                    "stm32g474"
                ],
                "gateTargets": [],
                "extraDefines": [
                    "HAL_ENABLE_ILI9341",
                    "HAL_DISPLAY_ILI9341"
                ]
            }
        ]
    },
    "toolchain": "cmake",
    "target": "rp2040",
    "board": "pico",
    "buildDir": "${jhRoot}/.build/examples/16_rtc_backends",
    "cmakeBuildDir": "${buildDir}/cmake",
    "cmake": {
        "sourceDir": "${project}/../../cmake/jh_firmware_project",
        "cache": {
            "JH_ARTIFACT_DIR": "${buildDir}",
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "16_rtc_backends",
            "JH_PROJECT_SOURCES": "app.c"
        }
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2",
        "compileCommands": "${buildDir}/compile_commands_patched.json"
    }
}
