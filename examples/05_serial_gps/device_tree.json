{
  "$schema": "../../config/hardware/device_tree.schema.json",
  "schemaVersion": 1,
  "nodes": {"gps": {"compatible": "jaszczurhal,uart-device"}},
  "assemblies": {
    "pico": {
      "target": "rp2040",
      "board": "pico",
      "clock": {"tree": "default"},
      "statusLed": {"node": "board.statusLed"},
      "buses": {
        "gpsUart": {
          "kind": "uart",
          "index": 0,
          "baudRate": 9600,
          "frame": {"dataBits": 8, "parity": "none", "stopBits": 1},
          "pins": {"tx": 0, "rx": 1}
        },
        "testUart": {
          "kind": "uart",
          "index": 1,
          "baudRate": 115200,
          "frame": {"dataBits": 8, "parity": "none", "stopBits": 1},
          "pins": {"tx": 4, "rx": 5}
        }
      },
      "nodes": {"gps": {"present": true, "bus": "gpsUart"}}
    },
    "pico2-arm": {
      "target": "rp2350-arm",
      "board": "pico2",
      "clock": {"tree": "default"},
