{
    "$schema": "../../../vscode/schema/jh_vscode_project.schema.json",
    "project": "JaszczurHAL examples",
    "module": "05_serial_gps",
    "example": {
        "targets": [
            "stm32g474",
            "rp2040",
            "rp2350-arm",
            "rp2350-riscv"
        ],
        "boards": {
            "rp2040": "pico",
            "rp2350-arm": "pico2",
            "rp2350-riscv": "pico2",
            "stm32g474": "nucleo-g474re"
        },
        "gateTargets": [
            "stm32g474",
            "rp2040"
        ],
        "covers": [
            "07_gps",
            "14_uart",
            "22_gps_uart",
            "45_swserial_loopback"
        ],
        "variants": [
            {
                "id": "swserial",
                "module": "05_serial_gps_swserial",
                "sources": [
                    "swserial_app.c"
                ],
                "targets": [
                    "rp2040",
                    "rp2350-arm",
                    "rp2350-riscv"
                ],
                "extraDefines": [
                    "EXAMPLE_SERIAL_GPS_USE_SWSERIAL=1"
                ],
                "gateTargets": [
                    "rp2040"
                ]
            }
        ]
    },
    "toolchain": "cmake",
    "target": "rp2040",
    "board": "pico",
    "buildDir": "${jhRoot}/.build/examples/05_serial_gps",
    "cmakeBuildDir": "${buildDir}/cmake",
    "cmake": {
        "sourceDir": "${project}/../../cmake/jh_firmware_project",
        "cache": {
            "JH_ARTIFACT_DIR": "${buildDir}",
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "05_serial_gps",
            "JH_PROJECT_SOURCES": "app.c"
        }
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2",
        "compileCommands": "${buildDir}/compile_commands_patched.json"
    }
}
