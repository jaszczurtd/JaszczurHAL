{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Project: Debug nucleo-canhat (STM32G474 / ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/../../.build/examples/21_stm32g474_fdcan_native/stm32g474/nucleo-canhat/firmware.elf",
            "servertype": "openocd",
            "device": "STM32G474RE",
            "configFiles": [
                "board/st_nucleo_g4.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "Project: Build (Debug) nucleo-canhat",
            "openOCDLaunchCommands": [
                "reset_config srst_only srst_nogate connect_assert_srst"
            ]
        }
    ]
}
