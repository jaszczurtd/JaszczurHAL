{
  "$schema": "../features.schema.json",
  "schemaVersion": 1,
  "domain": "storage",
  "symbols": {
    "HAL_ENABLE_EEPROM": {},
    "HAL_ENABLE_FAT": {
      "buildEffects": {
        "portableSources": [
          "src/hal/storage/filesystem/ff16/ff.c",
          "src/hal/storage/filesystem/ff16/ffsystem.c",
          "src/hal/storage/filesystem/ff16/ffunicode.c",
          "src/hal/storage/filesystem/ff16/hal_sd_spi_diskio.cpp",
          "src/hal/storage/filesystem/sd/hal_sd_file.cpp"
        ]
      }
    },
    "HAL_ENABLE_KV": {
      "implies": ["HAL_ENABLE_CRC", "HAL_ENABLE_EEPROM"]
    },
    "HAL_ENABLE_LITTLEFS": {
      "buildEffects": {
        "dependencies": ["littlefs"]
      }
    },
    "HAL_ENABLE_SDLOGGER": {
      "implies": ["HAL_ENABLE_EEPROM", "HAL_ENABLE_FAT", "HAL_ENABLE_SPI"]
    }
  }
}
