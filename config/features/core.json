{
  "$schema": "../features.schema.json",
  "schemaVersion": 1,
  "domain": "core",
  "symbols": {
    "HAL_DISABLE_ASSERTS": {},
    "HAL_ENABLE_APP_TASK1": {},
    "HAL_ENABLE_CJSON": {
      "buildEffects": {
        "portableSources": [
          "src/hal/codecs/cjson/cJSON.c",
          "src/hal/codecs/cjson/cJSON_Utils.c"
        ]
      }
    },
    "HAL_ENABLE_COMMAND_ROUTER": {
      "buildEffects": {
        "portableSources": [
          "src/hal/commands/hal_command_router.cpp",
          "src/hal/commands/hal_command_wire.cpp",
          "src/hal/commands/jh_command_adapter_internal.cpp"
        ]
      }
    },
    "HAL_ENABLE_CRC": {
      "buildEffects": {
        "portableSources": [
          "src/hal/security/hal_crc.cpp"
        ]
      }
    },
    "HAL_ENABLE_CRYPTO": {
      "buildEffects": {
        "portableSources": [
          "src/hal/network/wireguard/core/crypto/chacha20.c",
          "src/hal/network/wireguard/core/crypto/chacha20poly1305.c",
          "src/hal/network/wireguard/core/crypto/crypto.c",
          "src/hal/network/wireguard/core/crypto/poly1305-donna.c",
          "src/hal/security/hal_crypto.cpp",
          "src/hal/security/hal_sc_auth.cpp"
        ]
      }
    },
    "HAL_ENABLE_ADC_SCAN": {
      "buildEffects": {
        "portableSources": [
          "src/hal/analog/hal_adc_scan.cpp"
        ]
      }
    },
    "HAL_ENABLE_DAC": {},
    "HAL_ENABLE_DACLESS": {
      "buildEffects": {
        "portableSources": [
          "src/hal/audio/dacless/dacless.cpp",
          "src/hal/audio/hal_dacless.cpp"
        ]
      },
      "implies": [
        "HAL_ENABLE_DMA_PWM_AUDIO",
        "HAL_ENABLE_PWM_FREQ"
      ]
    },
    "HAL_ENABLE_DMA_PWM_AUDIO": {
      "buildEffects": {
        "portableSources": [
          "src/hal/audio/hal_dma_pwm_audio.cpp"
        ]
      }
    },
    "HAL_ENABLE_FREERTOS": {},
    "HAL_ENABLE_JPEG": {
      "buildEffects": {
        "portableSources": [
          "src/hal/codecs/jpeg/tjpgd.c"
        ]
      }
    },
    "HAL_ENABLE_JPEG_AS_BASE64": {
      "implies": [
        "HAL_ENABLE_CRYPTO",
        "HAL_ENABLE_JPEG"
      ]
    },
    "HAL_ENABLE_PCNT": {},
    "HAL_ENABLE_PULSE_CAPTURE": {
      "buildEffects": {
        "portableSources": [
          "src/hal/analog/hal_pulse_capture.cpp"
        ]
      }
    },
    "HAL_ENABLE_POWER_MANAGEMENT": {
      "implies": [
        "HAL_ENABLE_INTERNAL_RTC"
      ]
    },
    "HAL_ENABLE_PNG": {
      "buildEffects": {
        "portableSources": [
          "src/hal/codecs/lodepng/lodepng.cpp"
        ]
      }
    },
    "HAL_ENABLE_PNG_AS_BASE64": {
      "implies": [
        "HAL_ENABLE_CRYPTO",
        "HAL_ENABLE_PNG"
      ]
    },
    "HAL_ENABLE_PWM_FREQ": {},
    "HAL_ENABLE_RGB_LED": {
      "buildEffects": {
        "portableSources": [
          "src/hal/gpio/hal_rgb_led.cpp",
          "src/hal/gpio/neopixel/jh_neopixel.cpp"
        ]
      }
    },
    "HAL_ENABLE_STACK_GUARD": {},
    "HAL_ENABLE_STACK_PROTECTOR": {},
    "HAL_ENABLE_UNITY": {
      "buildEffects": {
        "featureSources": [
          "src/utils/unity.c"
        ]
      }
    }
  }
}
