{
  "$schema": "../clock_tree.schema.json",
  "schemaVersion": 1,
  "target": "rp2040",
  "trees": {
    "default": {
      "description": "Pico SDK default for RP2040: XOSC 12 MHz, PLL_SYS 1500 MHz / 6 / 2, PLL_USB 1200 MHz / 5 / 5.",
      "backend": "pico-sdk",
      "requiredSources": {
        "xosc": {
          "kind": "crystal",
          "frequencyHz": 12000000
        }
      },
      "frequenciesHz": {
        "ref": 12000000,
        "sys": 125000000,
        "peri": 125000000,
        "usb": 48000000,
        "adc": 48000000
      },
      "parameters": {
        "pllSysVcoHz": 1500000000,
        "pllSysPostdiv1": 6,
        "pllSysPostdiv2": 2,
        "pllUsbVcoHz": 1200000000,
        "pllUsbPostdiv1": 5,
        "pllUsbPostdiv2": 5
      }
    }
  }
}
