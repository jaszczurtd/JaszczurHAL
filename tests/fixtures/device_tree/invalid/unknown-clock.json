        "firstLed": {
          "present": true,
          "pins": {
            "out": {
              "net": "indicator"
            }
          }
        },
        "secondLed": {
          "present": true,
          "pins": {
            "out": {
              "net": "indicator"
            }
          }
        }
      },
      "nets": {
        "indicator": {
          "endpoint": {
            "domain": "soc-gpio",
            "id": 14
          },
          "owner": "firstLed.out"
        }
      }
    }
  }
