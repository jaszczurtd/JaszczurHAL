{
  "schemaVersion": 1,
  "bindings": [
    "../bindings/gpio-output.json"
  ],
  "nodes": {
    "firstLed": {
      "compatible": "test,gpio-output"
    },
    "secondLed": {
      "compatible": "test,gpio-output"
    }
  },
  "assemblies": {
    "pico": {
      "target": "rp2040",
      "board": "pico",
