{
  "schemaVersion": 1,
  "bindings": [
    "../bindings/gpio-output.json",
    "../bindings/spi-device.json",
    "../bindings/radio-module.json",
    "../bindings/can-channel.json",
    "../bindings/can-module.json",
    "../bindings/power-stage.json",
    "../bindings/expander.json"
  ],
  "nodes": {
    "stage": {
      "compatible": "test,power-stage"
    },
    "display": {
      "compatible": "test,spi-device"
    },
    "radioModule": {
      "compatible": "test,radio-module"
    },
    "canModule": {
      "compatible": "test,can-module"
    }
  },
  "assemblies": {
    "pico-rp2040": {
      "target": "rp2040",
      "board": "pico",
      "clock": {
        "tree": "default"
      },
      "statusLed": {
        "node": "board.statusLed"
      },
      "buses": {
        "peripheralSpi": {
          "kind": "spi",
          "index": 0,
          "frequencyHz": 4000000,
          "pins": {
            "sck": 2,
            "mosi": 3,
            "miso": 0
          }
        }
      },
      "nodes": {
        "stage": {
          "present": true,
          "pins": {
            "driveA": 9,
            "driveB": 10,
            "feedback": 26
          }
        },
        "display": {
          "present": true,
          "bus": "peripheralSpi",
          "pins": {
            "cs": 1,
            "int": null
          }
        },
        "radioModule": {
          "present": true,
          "pins": {
            "chipSelect": 1
          }
        },
        "radioModule.radio": {
          "bus": "peripheralSpi",
          "pins": {
            "int": 4
          }
        },
        "radioModule.indicator": {
          "pins": {
            "out": 8
          }
        },
        "canModule": {
          "present": false
        }
      }
    }
  }
}
