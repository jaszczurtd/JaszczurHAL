{
  "schemaVersion": 1,
  "compatible": "test,can-channel",
  "description": "Synthetic transceiver connected to a target CAN controller.",
  "domain": "can",
  "controller": {
    "kind": "fdcan",
    "required": true
  },
  "signals": {
    "rx": {
      "direction": "input",
      "required": true,
      "domains": [
        "soc-gpio"
      ]
    },
    "tx": {
      "direction": "output",
      "required": true,
      "domains": [
        "soc-gpio"
      ]
    },
    "standby": {
      "direction": "output",
      "required": false,
      "domains": [
        "soc-gpio"
      ]
    }
  },
  "properties": {
    "maxBitrateHz": {
      "type": "integer",
      "cType": "uint32",
      "unit": "Hz",
      "description": "Transceiver data-rate limit.",
      "default": 5000000,
      "minimum": 1,
      "maximum": 5000000
    }
  },
  "requiresFeatures": [
    "HAL_ENABLE_CAN"
  ]
}
