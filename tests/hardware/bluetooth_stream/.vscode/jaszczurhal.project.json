{
    "$schema": "../../../../vscode/schema/jh_vscode_project.schema.json",
    "project": "JaszczurHAL hardware tests",
    "module": "bluetooth_stream",
    "example": {
        "targets": [
            "stm32g474",
            "rp2350-arm",
            "rp2040"
        ],
        "boards": {
            "stm32g474": "nucleo-g474re-pim730",
            "rp2350-arm": "pico2w",
            "rp2040": "picow"
        },
        "hardwareMatrix": [
            {
                "target": "rp2040",
                "board": "picow",
                "runtime": "baremetal"
            },
            {
                "target": "rp2040",
                "board": "picow",
                "runtime": "freertos"
            },
            {
                "target": "rp2040",
                "board": "pico-rm2",
                "runtime": "baremetal"
            },
            {
                "target": "rp2040",
                "board": "pico-rm2",
                "runtime": "freertos"
            },
            {
                "target": "rp2350-arm",
                "board": "pico2w",
                "runtime": "baremetal"
            },
            {
                "target": "rp2350-arm",
                "board": "pico2w",
                "runtime": "freertos"
            },
            {
                "target": "stm32g474",
                "board": "nucleo-g474re-pim730",
                "runtime": "baremetal"
            },
            {
                "target": "stm32g474",
                "board": "nucleo-g474re-pim730",
                "runtime": "freertos"
            }
        ],
        "variants": [
            {
                "id": "freertos",
                "module": "bluetooth_stream_freertos",
                "targets": [
                    "stm32g474",
                    "rp2350-arm",
                    "rp2040"
                ],
                "extraDefines": [
                    "HAL_ENABLE_FREERTOS"
                ]
            },
            {
                "id": "display",
                "module": "bluetooth_stream_display",
                "targets": [
                    "stm32g474"
                ],
                "extraDefines": [
                    "JHBL5_ENABLE_DISPLAY=1",
                    "HAL_ENABLE_ILI9341",
                    "HAL_DISPLAY_ILI9341"
                ]
            },
            {
                "id": "display-freertos",
                "module": "bluetooth_stream_display_freertos",
                "targets": [
                    "stm32g474"
                ],
                "extraDefines": [
                    "JHBL5_ENABLE_DISPLAY=1",
                    "HAL_ENABLE_ILI9341",
                    "HAL_DISPLAY_ILI9341",
                    "HAL_ENABLE_FREERTOS"
                ]
            }
        ]
    },
    "toolchain": "cmake",
    "target": "stm32g474",
    "board": "nucleo-g474re-pim730",
    "buildDir": "${jhRoot}/.build/hardware/bluetooth_stream",
    "cmakeBuildDir": "${buildDir}/cmake",
    "cmake": {
        "sourceDir": "${project}/../../../cmake/jh_firmware_project",
        "cache": {
            "JH_ARTIFACT_DIR": "${buildDir}",
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "bluetooth_stream",
            "JH_PROJECT_SOURCES": "app.cpp"
        }
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2",
        "map": "${buildDir}/firmware.map",
        "compileCommands": "${buildDir}/compile_commands_patched.json"
    }
}
