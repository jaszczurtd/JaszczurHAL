{
    "$schema": "../../../../vscode/schema/jh_vscode_project.schema.json",
    "project": "JaszczurHAL hardware tests",
    "module": "rp_ota",
    "example": {
        "targets": [
            "rp2040",
            "rp2350-arm"
        ],
        "boards": {
            "rp2040": "picow",
            "rp2350-arm": "pico2w"
        },
        "variants": [
            {
                "id": "freertos",
                "module": "rp_ota_freertos",
                "targets": [
                    "rp2040",
                    "rp2350-arm"
                ],
                "extraDefines": [
                    "HAL_ENABLE_OTA",
                    "HAL_ENABLE_FREERTOS"
                ]
            }
        ]
    },
    "toolchain": "cmake",
    "target": "rp2040",
    "board": "picow",
    "buildDir": "${jhRoot}/.build/hardware/rp_ota",
    "cmakeBuildDir": "${buildDir}/cmake",
    "cmake": {
        "sourceDir": "${project}/../../../cmake/jh_firmware_project",
        "cache": {
            "JH_ARTIFACT_DIR": "${buildDir}",
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "rp_ota",
            "JH_EXTRA_DEFINES": "HAL_ENABLE_OTA",
            "JH_OTA_GENERATION": 1,
            "JH_OTA_VERSION": "hardware-fixture"
        }
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2",
        "compileCommands": "${buildDir}/compile_commands_patched.json",
        "ota": "${buildDir}/firmware.ota"
    },
    "ota": {
        "port": 8266,
        "passwordEnv": "JH_OTA_TEST_PASSWORD"
    }
}
