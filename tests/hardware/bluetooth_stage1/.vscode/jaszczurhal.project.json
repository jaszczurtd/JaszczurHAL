{
    "$schema": "../../../../vscode/schema/jh_vscode_project.schema.json",
    "project": "JaszczurHAL hardware tests",
    "module": "bluetooth_stage1",
    "example": {
        "targets": [
            "stm32g474",
            "rp2350-arm",
            "rp2040"
        ],
        "boards": {
            "stm32g474": "nucleo-g474re-pim730",
            "rp2350-arm": "pico2w",
            "rp2040": "picow"
        },
        "variants": [
            {
                "id": "bluetooth",
                "module": "bluetooth_stage1",
                "sources": ["app.c"],
                "extraDefines": ["JH_BLUETOOTH_STAGE1_PROBE"],
                "targets": ["stm32g474", "rp2350-arm", "rp2040"]
            },
            {
                "id": "wifi-only",
                "module": "bluetooth_stage1_wifi_baseline",
                "sources": ["app_wifi_baseline.c"],
                "targets": ["stm32g474", "rp2350-arm", "rp2040"],
                "cmake": {
                    "cache": {"JH_EXTRA_DEFINES": ""}
                }
            }
        ]
    },
    "toolchain": "cmake",
    "target": "stm32g474",
    "board": "nucleo-g474re-pim730",
    "buildDir": "${jhRoot}/.build/hardware/bluetooth_stage1",
    "cmakeBuildDir": "${buildDir}/cmake",
    "cmake": {
        "sourceDir": "${project}/../../../cmake/jh_firmware_project",
        "cache": {
            "JH_ARTIFACT_DIR": "${buildDir}",
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "bluetooth_stage1",
            "JH_PROJECT_SOURCES": "app.c",
            "JH_EXTRA_DEFINES": "JH_BLUETOOTH_STAGE1_PROBE"
        }
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2",
        "map": "${buildDir}/firmware.map",
        "compileCommands": "${buildDir}/compile_commands_patched.json"
    }
}
