{
  "$schema": "../../../config/hardware/device_tree.schema.json",
  "schemaVersion": 1,
  "nodes": {
    "wifi": {
      "compatible": "pimoroni,pim730"
    }
  },
  "assemblies": {
    "picow": {
      "target": "rp2040",
      "board": "picow",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed" },
      "nodes": {
        "wifi": { "present": false }
      }
    },
    "pico2w": {
      "target": "rp2350-arm",
      "board": "pico2w",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed" },
      "nodes": {
        "wifi": { "present": false }
      }
    },
    "nucleo-pim730": {
      "target": "stm32g474",
      "board": "nucleo-g474re",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed" },
      "nodes": {
        "wifi": {
          "present": true,
          "pins": { "wlOn": "PB14", "cs": "PB12", "data": "PB15", "clock": "PB13" }
        }
      }
    }
  }
}
