{
  "id": "stm32g474",
  "displayName": "STMicroelectronics STM32G474 (bare-metal)",
  "toolchain": "cmake",
  "defaultBoard": "nucleo-g474re",
  "upload": {
    "strategy": "openocd",
    "openocd": { "interface": "interface/stlink.cfg", "target": "target/stm32g4x.cfg" }
  },
  "monitor": { "transport": "serial" },
  "cache": {
    "JH_TARGET": "stm32g474",
    "CMAKE_TOOLCHAIN_FILE": "${jhRoot}/stm32_lib/toolchain_stm32g474.cmake"
  },
  "boards": [
    { "id": "nucleo-g474re", "displayName": "NUCLEO-G474RE (512 KB flash / 128 KB RAM)", "cache": {} }
  ]
}
