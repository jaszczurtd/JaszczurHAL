{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaszczur.dev/schemas/jh_vscode_project.schema.json",
  "title": "JaszczurHAL VS Code Project",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "object",
      "description": "Optional metadata for checked-in example projects. jh-vscode ignores it except for variant selection and friendly unsupported-target diagnostics.",
      "additionalProperties": true,
      "properties": {
        "targets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "boards": {
          "type": "object",
          "description": "Default board id used by the automated example dispatcher for each declared target.",
          "additionalProperties": { "type": "string" }
        },
        "gateTargets": {
          "type": "array",
          "description": "Representative target subset compiled by the examples quality gate. Supported targets remain declared in targets.",
          "items": { "type": "string" }
        },
        "covers": {
          "type": "array",
          "description": "Historical example ids whose functionality is represented by this consolidated project.",
          "items": { "type": "string" }
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "module": { "type": "string" },
              "sources": {
                "type": "array",
                "items": { "type": "string" }
              },
              "targets": {
                "type": "array",
                "items": { "type": "string" }
              },
              "gateTargets": {
                "type": "array",
                "description": "Representative target subset compiled for this variant by the examples quality gate.",
                "items": { "type": "string" }
              },
              "extraDefines": {
                "type": "array",
                "description": "Additional compile definitions applied by the active variant. HAL_ENABLE_* entries must be bare or use the explicit value 1.",
                "items": { "type": "string" }
              },
              "cmake": { "type": "object", "additionalProperties": true }
            }
          }
        }
      }
    },
    "toolchain": {
      "type": "string",
      "enum": ["cmake", "custom"]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Active target family id (e.g. rp2040, rp2350-arm, rp2350-riscv, stm32g474). Absent = rp2040."
    },
    "board": {
      "type": "string",
      "minLength": 1,
      "description": "Active physical board profile id within the active target (resolved against boards/targets and boards/profiles)."
    },
    "buildDir": {
      "type": "string",
      "minLength": 1
    },
    "cmakeBuildDir": {
      "type": "string",
      "minLength": 1
    },
    "cmake": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sourceDir": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "description": "Optional explicit CMake executable. The verified Windows bootstrap path is used by default on native Windows."
        },
        "generator": {
          "type": "string",
          "minLength": 1,
          "description": "Optional CMake generator override. Firmware builds default to Ninja."
        },
        "cache": {
          "type": "object",
          "description": "Effective CMake cache entries. In JH_EXTRA_DEFINES and EXTRA_HAL_DEFINES, each HAL_ENABLE_* entry must be a standalone simple token separated with semicolons and must be bare or use the explicit value 1. Whitespace does not separate multiple feature definitions, and CMake generator expressions are unsupported.",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        },
        "targets": {
          "type": "object",
          "description": "CMake target-name alias map (build/buildDebug/upload/compileDb -> concrete CMake target names). NOT a multi-target profile map; see targetProfiles.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "targetProfiles": {
      "type": "object",
      "description": "Per-target overlay manifests, keyed by target id (rp2040, rp2350-arm, stm32g474, ...). Deliberately NOT named 'targets' to avoid colliding with cmake.targets. The active target's overlay is deep-merged over the base manifest during resolution; absent = single implicit native rp2040 profile.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "toolchain": {
            "type": "string",
            "enum": ["cmake", "custom"]
          },
          "buildDir": { "type": "string" },
          "cmakeBuildDir": { "type": "string" },
          "cmake": { "type": "object", "additionalProperties": true },
          "upload": { "type": "object", "additionalProperties": true },
          "identity": { "type": "object", "additionalProperties": true },
          "artifacts": { "type": "object", "additionalProperties": true },
          "ota": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "usbManufacturer": {
          "type": "string"
        },
        "usbProduct": {
          "type": "string"
        },
        "usbSerialNumber": {
          "type": "string"
        },
        "usbInterface": {
          "type": "string"
        },
        "usbLocation": {
          "type": "string"
        },
        "usbVid": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 65535 },
            { "type": "string" }
          ]
        },
        "usbPid": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 65535 },
            { "type": "string" }
          ]
        },
        "byIdHint": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "elf": {
          "type": "string"
        },
        "uf2": {
          "type": "string"
        },
        "ota": {
          "type": "string"
        },
        "compileCommands": {
          "type": "string"
        }
      }
    },
    "upload": {
      "type": "object",
      "description": "Upload configuration. Stable dispatcher paths cover RP-family UF2/serial-style upload and STM32 OpenOCD; custom/esptool are reserved extension points.",
      "additionalProperties": true,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["serial", "uf2", "custom", "openocd", "esptool"]
        },
        "port": {
          "type": "string"
        },
        "bootselVolume": {
          "type": "string",
          "description": "Optional user-local BOOTSEL drive root or Windows volume GUID used to disambiguate UF2 upload."
        },
        "byId": {
          "type": "string"
        },
        "openocd": {
          "type": "object",
          "description": "OpenOCD parameters for strategy=openocd (SWD flash, e.g. STM32). No serial port / BOOTSEL / by-id identity logic applies.",
          "additionalProperties": true,
          "properties": {
            "bin": { "type": "string" },
            "interface": { "type": "string" },
            "target": { "type": "string" }
          }
        }
      }
    },
    "ota": {
      "type": "object",
      "description": "Native RP OTA discovery and authenticated upload settings.",
      "additionalProperties": true,
      "properties": {
        "hostname": { "type": "string" },
        "host": { "type": "string" },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8266
        },
        "listenPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 8266,
          "description": "Host TCP callback port. Set zero explicitly to request an ephemeral port."
        },
        "broadcast": { "type": "string" },
        "password": {
          "type": "string",
          "description": "Inline development-only password; prefer passwordEnv."
        },
        "passwordEnv": { "type": "string" },
        "allowEmptyPassword": { "type": "boolean" }
      }
    },
    "hooks": {
      "type": "object",
      "description": "Reserved hook configuration. The current runtime preserves/expands this section as data, but does not provide a stable executed hook system.",
      "additionalProperties": true,
      "properties": {
        "preBuild": {
          "type": "string"
        },
        "postBuild": {
          "type": "string"
        },
        "preUpload": {
          "type": "string"
        },
        "postUpload": {
          "type": "string"
        }
      }
    }
  }
}
