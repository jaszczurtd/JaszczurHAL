{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaszczur.dev/schemas/jh_vscode_project.schema.json",
  "title": "JaszczurHAL VS Code Project",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "toolchain": {
      "type": "string",
      "enum": ["arduino-cli", "cmake", "custom"]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Active target family id (e.g. rp2040, stm32g474). Absent = rp2040 (current behaviour)."
    },
    "board": {
      "type": "string",
      "minLength": 1,
      "description": "Active board/variant id within the active target (resolved against the target registry in vscode/targets/<target>.json)."
    },
    "fqbn": {
      "type": "string",
      "minLength": 1
    },
    "buildDir": {
      "type": "string",
      "minLength": 1
    },
    "cmakeBuildDir": {
      "type": "string",
      "minLength": 1
    },
    "cmake": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sourceDir": {
          "type": "string",
          "minLength": 1
        },
        "cache": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        },
        "targets": {
          "type": "object",
          "description": "CMake target-name alias map (build/buildDebug/upload/compileDb -> concrete CMake target names). NOT a multi-target profile map; see targetProfiles.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "targetProfiles": {
      "type": "object",
      "description": "Per-target overlay manifests, keyed by target id (rp2040, stm32g474, ...). Deliberately NOT named 'targets' to avoid colliding with cmake.targets. The active target's overlay is deep-merged over the base manifest during resolution; absent = single implicit rp2040 profile (current behaviour).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "toolchain": {
            "type": "string",
            "enum": ["arduino-cli", "cmake", "custom"]
          },
          "buildDir": { "type": "string" },
          "cmakeBuildDir": { "type": "string" },
          "cmake": { "type": "object", "additionalProperties": true },
          "upload": { "type": "object", "additionalProperties": true },
          "identity": { "type": "object", "additionalProperties": true },
          "artifacts": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "usbManufacturer": {
          "type": "string"
        },
        "usbProduct": {
          "type": "string"
        },
        "byIdHint": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "elf": {
          "type": "string"
        },
        "uf2": {
          "type": "string"
        },
        "compileCommands": {
          "type": "string"
        }
      }
    },
    "upload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["serial", "uf2", "custom", "openocd", "esptool"]
        },
        "port": {
          "type": "string"
        },
        "byId": {
          "type": "string"
        },
        "openocd": {
          "type": "object",
          "description": "OpenOCD parameters for strategy=openocd (SWD flash, e.g. STM32). No serial port / BOOTSEL / by-id identity logic applies.",
          "additionalProperties": true,
          "properties": {
            "bin": { "type": "string" },
            "interface": { "type": "string" },
            "target": { "type": "string" }
          }
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "preBuild": {
          "type": "string"
        },
        "postBuild": {
          "type": "string"
        },
        "preUpload": {
          "type": "string"
        },
        "postUpload": {
          "type": "string"
        }
      }
    }
  }
}
