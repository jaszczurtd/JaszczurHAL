{
    "$schema": "../schema/jh_vscode_project.schema.json",
    "project": "example-project",
    "module": "firmware",
    "toolchain": "cmake",
    "target": "rp2040",
    "board": "pico",
    "buildDir": "${project}/.build",
    "cmakeBuildDir": "${project}/.build/cmake",
    "cmake": {
        "sourceDir": "${project}/../../libraries/JaszczurHAL/cmake/jh_firmware_project",
        "cache": {
            "JH_PROJECT_DIR": "${project}",
            "JH_MODULE_NAME": "firmware"
        }
    },
    "identity": {
        "enabled": true,
        "usbManufacturer": "Jaszczur",
        "usbProduct": "Example Firmware",
        "byIdHint": "Example_Firmware"
    },
    "artifacts": {
        "elf": "${buildDir}/firmware.elf",
        "uf2": "${buildDir}/firmware.uf2",
        "compileCommands": "${buildDir}/compile_commands_patched.json"
    }
}
