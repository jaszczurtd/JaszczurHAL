cmake_minimum_required(VERSION 3.22)
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(STRINGS "${_root}/third_party/pcre2_version.conf" _pin REGEX "^PCRE2_(REPO|REF|DIR)=")
foreach(_line IN LISTS _pin)
    if(_line MATCHES "^PCRE2_REPO=(.+)$")
        set(_repo "${CMAKE_MATCH_1}")
    elseif(_line MATCHES "^PCRE2_REF=(.+)$")
        set(_ref "${CMAKE_MATCH_1}")
    elseif(_line MATCHES "^PCRE2_DIR=(.+)$")
        set(_source "${_root}/${CMAKE_MATCH_1}")
    endif()
endforeach()
string(LENGTH "${_ref}" _ref_length)
if(NOT _repo OR NOT _ref_length EQUAL 40 OR NOT _ref MATCHES "^[0-9a-f]+$" OR
    NOT IS_DIRECTORY "${_source}" OR IS_SYMLINK "${_source}")
    message(FATAL_ERROR "Invalid PCRE2 pin or missing managed checkout; run scripts/ensure_pcre2.sh")
endif()
if(NOT DEFINED JH_VERIFY_JHBASE_DIR)
    include("${CMAKE_CURRENT_LIST_DIR}/jh_jhbase.cmake")
    jh_jhbase_dir(JH_VERIFY_JHBASE_DIR)
endif()
include("${JH_VERIFY_JHBASE_DIR}/cmake/git_dependency.cmake")
# JIT is disabled. Its gitlink must remain empty, never an unchecked source tree.
jb_check_git_dependency("${_source}" "${_repo}" "${_ref}" _error
    EMPTY_SUBMODULES deps/sljit)
if(NOT _error STREQUAL "")
    message(FATAL_ERROR "${_error}. Run scripts/ensure_jhbase.sh and scripts/ensure_pcre2.sh")
endif()
