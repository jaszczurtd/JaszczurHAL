cmake_minimum_required(VERSION 3.22)
# Build the jh host CLI of one JaszczurHAL checkout once per set of inputs and
# publish it below <output root>/<host variant>/<key>/bin. Script mode only:
#
#   cmake -DJH_ROOT=<checkout> [-DJH_RESULT_FILE=<file>] [-DJH_ARCH=x64|x86]
#         [-DJH_OUTPUT_ROOT=<dir>] [-DJH_GENERATOR=<name>] [-DJH_JOBS=<n>]
#         [-DJH_BUILD_TYPE=<config>] -P scripts/jh_bootstrap.cmake
#
# The key covers every input of the tool build: the tools/jh sources, the
# CMake modules and pins they read, this script, the verified revisions of
# jhbase, utf8proc and PCRE2, the host variant, the compiler, the generator,
# the build type and the CMake version. A published executable is reused only
# when its manifest records the same key and its SHA-256 still matches.
# Nothing is selected through PATH, version numbers or timestamps.
#
# JH_ARCH chooses the Windows process architecture (x64 default, x86 for a
# 32-bit process on Windows x64). On Linux the variant follows the target
# triple of the host compiler, so a 32-bit user space on a 64-bit kernel
# builds the 32-bit variant. JH_DEPENDENCY_ROOT in the environment takes the
# managed checkouts (third_party/jhbase, utf8proc, pcre2) from another
# JaszczurHAL checkout, verified against the pins of JH_ROOT; an index
# snapshot of the hook uses it. JH_JHBASE_DIR selects an external jhbase.
#
# Prerequisites on the host: CMake 3.22+, Git, a C11/C++17 compiler (GCC or
# Clang with Ninja or Make on Linux; Visual Studio 2022 or cl.exe with Ninja
# on Windows). The managed checkouts come from scripts/ensure_jhbase.sh,
# scripts/ensure_utf8proc.sh and scripts/ensure_pcre2.sh; this script never
# downloads anything.

function(jh_fail message)
  message(FATAL_ERROR "[jh-bootstrap] ${message}")
endfunction()

# Read PREFIX_REPO, PREFIX_REF and PREFIX_DIR from a pin file.
function(jh_read_pin file prefix out_repo out_ref out_dir)
  if(NOT EXISTS "${file}")
    jh_fail("Pin file is missing: ${file}")
  endif()
  file(STRINGS "${file}" lines REGEX "^${prefix}_(REPO|REF|DIR)=")
  set(repo "")
  set(ref "")
  set(dir "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^${prefix}_REPO=(.+)$")
      set(repo "${CMAKE_MATCH_1}")
    elseif(line MATCHES "^${prefix}_REF=(.+)$")
      set(ref "${CMAKE_MATCH_1}")
    elseif(line MATCHES "^${prefix}_DIR=(.+)$")
      set(dir "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  string(LENGTH "${ref}" ref_length)
  if(repo STREQUAL "" OR NOT ref_length EQUAL 40 OR NOT ref MATCHES "^[0-9a-f]+$")
    jh_fail("Invalid pin in ${file}: ${prefix}_REPO and a 40-hex ${prefix}_REF are required")
  endif()
  set(${out_repo} "${repo}" PARENT_SCOPE)
  set(${out_ref} "${ref}" PARENT_SCOPE)
  set(${out_dir} "${dir}" PARENT_SCOPE)
endfunction()

# JSON string literal of a value, escaping what paths and messages contain.
function(jh_json_quote out value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

# First line of a command's output, or an empty string.
function(jh_first_line out)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE text
    ERROR_VARIABLE text OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT rc EQUAL 0)
    set(text "")
  endif()
  string(REGEX REPLACE "\r?\n.*$" "" text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# The compiler CMake detected for a build tree, from its CMakeCXXCompiler.cmake
# record: pointer size, path, id and version.
function(jh_read_compiler_info work out_pointer_size out_path out_id out_version)
  file(GLOB records "${work}/CMakeFiles/*/CMakeCXXCompiler.cmake")
  list(LENGTH records count)
  if(NOT count EQUAL 1)
    jh_fail("Expected one CMakeCXXCompiler.cmake below ${work}/CMakeFiles, found ${count}")
  endif()
  list(GET records 0 record)
  include("${record}")
  set(${out_pointer_size} "${CMAKE_SIZEOF_VOID_P}" PARENT_SCOPE)
  set(${out_path} "${CMAKE_CXX_COMPILER}" PARENT_SCOPE)
  set(${out_id} "${CMAKE_CXX_COMPILER_ID}" PARENT_SCOPE)
  set(${out_version} "${CMAKE_CXX_COMPILER_VERSION}" PARENT_SCOPE)
endfunction()

# The published executable of a key directory is usable: its manifest records
# this key and the file still has the recorded SHA-256.
function(jh_published_ok key_dir key exe_name out)
  set(${out} FALSE PARENT_SCOPE)
  set(manifest "${key_dir}/bin/manifest.json")
  set(exe "${key_dir}/bin/${exe_name}")
  if(NOT EXISTS "${manifest}" OR NOT EXISTS "${exe}")
    return()
  endif()
  file(READ "${manifest}" text)
  string(JSON recorded_key ERROR_VARIABLE error GET "${text}" key)
  if(error OR NOT recorded_key STREQUAL key)
    return()
  endif()
  string(JSON recorded_sha ERROR_VARIABLE error GET "${text}" executable sha256)
  if(error)
    return()
  endif()
  file(SHA256 "${exe}" actual_sha)
  if(actual_sha STREQUAL recorded_sha)
    set(${out} TRUE PARENT_SCOPE)
  endif()
endfunction()

# ---------------------------------------------------------------------------
# Inputs
if(NOT DEFINED JH_ROOT OR JH_ROOT STREQUAL "")
  jh_fail("JH_ROOT is required: the JaszczurHAL checkout to build jh from")
endif()
get_filename_component(JH_ROOT "${JH_ROOT}" ABSOLUTE)
if(NOT EXISTS "${JH_ROOT}/tools/jh/CMakeLists.txt")
  jh_fail("${JH_ROOT} is not a JaszczurHAL checkout (tools/jh/CMakeLists.txt is missing)")
endif()
set(dependency_root "${JH_ROOT}")
if(DEFINED ENV{JH_DEPENDENCY_ROOT} AND NOT "$ENV{JH_DEPENDENCY_ROOT}" STREQUAL "")
  get_filename_component(dependency_root "$ENV{JH_DEPENDENCY_ROOT}" ABSOLUTE)
endif()
if(NOT DEFINED JH_OUTPUT_ROOT OR JH_OUTPUT_ROOT STREQUAL "")
  set(JH_OUTPUT_ROOT "${JH_ROOT}/.build/host-tools")
endif()
get_filename_component(JH_OUTPUT_ROOT "${JH_OUTPUT_ROOT}" ABSOLUTE)
if(NOT DEFINED JH_BUILD_TYPE OR JH_BUILD_TYPE STREQUAL "")
  set(JH_BUILD_TYPE Release)
endif()
if(NOT DEFINED JH_GENERATOR)
  set(JH_GENERATOR "")
endif()
if(NOT DEFINED JH_ARCH OR JH_ARCH STREQUAL "")
  set(JH_ARCH x64)
endif()
find_program(jh_git NAMES git NO_CACHE)
if(NOT jh_git)
  jh_fail("Git is required to verify the managed checkouts")
endif()

# ---------------------------------------------------------------------------
# Host variant and compiler
set(platform "")
set(compiler_c "")
set(compiler_cxx "")
set(exe_name jh)
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  set(os linux)
  foreach(pair "gcc;g++" "clang;clang++" "cc;c++")
    list(GET pair 0 c_name)
    list(GET pair 1 cxx_name)
    find_program(found_c NAMES "${c_name}" NO_CACHE)
    find_program(found_cxx NAMES "${cxx_name}" NO_CACHE)
    if(found_c AND found_cxx)
      set(compiler_c "${found_c}")
      set(compiler_cxx "${found_cxx}")
      break()
    endif()
  endforeach()
  if(compiler_cxx STREQUAL "")
    jh_fail("No host C/C++ compiler pair (gcc/g++, clang/clang++ or cc/c++) is in PATH")
  endif()
  jh_first_line(triple "${compiler_cxx}" -dumpmachine)
  jh_first_line(compiler_version "${compiler_cxx}" --version)
  if(triple STREQUAL "" OR compiler_version STREQUAL "")
    jh_fail("${compiler_cxx} does not report its target triple and version")
  endif()
  if(triple MATCHES "^(x86_64|aarch64|powerpc64|ppc64|riscv64|s390x|mips64|loongarch64)")
    set(expected_pointer_size 8)
  elseif(triple MATCHES "^(arm|armv[0-9]|i[3-6]86|riscv32|mips)")
    set(expected_pointer_size 4)
  else()
    jh_fail("Unsupported host target ${triple}; the supported Linux hosts are x86-64, AArch64 and 32-bit Arm")
  endif()
  set(variant "linux-${triple}")
  set(compiler_identity "${compiler_cxx} ${compiler_version} ${triple}")
  if(JH_GENERATOR STREQUAL "")
    find_program(found_ninja NAMES ninja NO_CACHE)
    if(found_ninja)
      set(JH_GENERATOR Ninja)
    else()
      set(JH_GENERATOR "Unix Makefiles")
    endif()
  endif()
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
  set(os windows)
  set(exe_name jh.exe)
  if(JH_ARCH STREQUAL "x64")
    set(platform x64)
    set(expected_pointer_size 8)
  elseif(JH_ARCH STREQUAL "x86")
    set(platform Win32)
    set(expected_pointer_size 4)
  else()
    jh_fail("JH_ARCH must be x64 or x86, got ${JH_ARCH}")
  endif()
  set(variant "windows-${JH_ARCH}")
  if(JH_GENERATOR STREQUAL "Ninja")
    find_program(found_cl NAMES cl NO_CACHE)
    if(NOT found_cl)
      jh_fail("cl.exe is not in PATH; open the ${JH_ARCH} developer shell or use the Visual Studio generator")
    endif()
    execute_process(COMMAND "${found_cl}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE banner)
    if(NOT banner MATCHES "Version ([0-9.]+) for (x86|x64|ARM64)")
      jh_fail("cl.exe did not report its version and target")
    endif()
    set(compiler_version "${CMAKE_MATCH_1}")
    set(cl_target "${CMAKE_MATCH_2}")
    if(NOT cl_target STREQUAL JH_ARCH)
      jh_fail("cl.exe in PATH targets ${cl_target}; requested ${JH_ARCH}. Open the matching developer shell")
    endif()
    set(compiler_c "${found_cl}")
    set(compiler_cxx "${found_cl}")
    set(compiler_identity "${found_cl} ${compiler_version} ${cl_target}")
    set(platform "")
  else()
    set(vswhere "$ENV{ProgramFiles\(x86\)}/Microsoft Visual Studio/Installer/vswhere.exe")
    if(NOT EXISTS "${vswhere}")
      jh_fail("vswhere.exe is missing; install Visual Studio 2022 Build Tools with the MSVC x64/x86 toolset")
    endif()
    jh_first_line(vs_path "${vswhere}" -latest -products * -requires
      Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath)
    jh_first_line(vs_version "${vswhere}" -latest -products * -requires
      Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationVersion)
    if(vs_path STREQUAL "" OR NOT vs_version MATCHES "^([0-9]+)\\.")
      jh_fail("No Visual Studio with the MSVC x64/x86 toolset was found")
    endif()
    if(CMAKE_MATCH_1 EQUAL 17)
      set(JH_GENERATOR "Visual Studio 17 2022")
    elseif(CMAKE_MATCH_1 EQUAL 16)
      set(JH_GENERATOR "Visual Studio 16 2019")
    else()
      jh_fail("Unsupported Visual Studio version ${vs_version}; 2019 or 2022 is required")
    endif()
    file(TO_CMAKE_PATH "${vs_path}" vs_path)
    set(compiler_identity "msvc ${vs_version} ${vs_path} ${platform}")
  endif()
else()
  jh_fail("Unsupported host ${CMAKE_HOST_SYSTEM_NAME}; jh builds on Linux and Windows")
endif()

# ---------------------------------------------------------------------------
# Dependencies: verified managed checkouts and their revisions
set(jhbase_external FALSE)
if(DEFINED ENV{JH_JHBASE_DIR} AND NOT "$ENV{JH_JHBASE_DIR}" STREQUAL "")
  get_filename_component(jhbase_dir "$ENV{JH_JHBASE_DIR}" ABSOLUTE)
  set(jhbase_external TRUE)
else()
  jh_read_pin("${JH_ROOT}/third_party/jhbase_version.conf" JHBASE jhbase_repo jhbase_ref jhbase_rel)
  if(jhbase_rel STREQUAL "")
    jh_fail("JHBASE_DIR is missing from third_party/jhbase_version.conf")
  endif()
  get_filename_component(jhbase_dir "${dependency_root}/${jhbase_rel}" ABSOLUTE)
endif()
if(NOT EXISTS "${jhbase_dir}/cmake/git_dependency.cmake" OR NOT EXISTS "${jhbase_dir}/include/jb/file.h")
  jh_fail("jhbase is missing at ${jhbase_dir}; run scripts/ensure_jhbase.sh")
endif()
include("${jhbase_dir}/cmake/git_dependency.cmake")
if(jhbase_external)
  # An external checkout may carry local work: its tracked and untracked file
  # contents join the key instead of a pinned revision.
  execute_process(COMMAND "${jh_git}" -C "${jhbase_dir}" rev-parse HEAD
    RESULT_VARIABLE rc OUTPUT_VARIABLE jhbase_revision OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT rc EQUAL 0)
    jh_fail("JH_JHBASE_DIR is not a git checkout: ${jhbase_dir}")
  endif()
  execute_process(COMMAND "${jh_git}" -C "${jhbase_dir}" ls-files -co --exclude-standard
    RESULT_VARIABLE rc OUTPUT_VARIABLE listed ERROR_QUIET)
  if(NOT rc EQUAL 0)
    jh_fail("Cannot list the external jhbase checkout ${jhbase_dir}")
  endif()
  string(REPLACE "\n" ";" listed "${listed}")
  set(jhbase_content "")
  foreach(path IN LISTS listed)
    if(NOT path STREQUAL "" AND EXISTS "${jhbase_dir}/${path}" AND NOT IS_DIRECTORY "${jhbase_dir}/${path}")
      file(SHA256 "${jhbase_dir}/${path}" sha)
      string(APPEND jhbase_content "${sha}  ${path}\n")
    endif()
  endforeach()
  string(SHA256 jhbase_content_hash "${jhbase_content}")
  set(jhbase_key "external ${jhbase_revision} ${jhbase_content_hash}")
else()
  jb_check_git_dependency("${jhbase_dir}" "${jhbase_repo}" "${jhbase_ref}" error)
  if(NOT error STREQUAL "")
    jh_fail("${error}. Run scripts/ensure_jhbase.sh")
  endif()
  set(jhbase_revision "${jhbase_ref}")
  set(jhbase_key "${jhbase_ref}")
endif()

jh_read_pin("${jhbase_dir}/third_party/utf8proc_version.conf" UTF8PROC utf8proc_repo utf8proc_ref unused)
file(READ "${JH_ROOT}/config/tooling/managed_components.json" components_json)
string(JSON utf8proc_rel ERROR_VARIABLE error GET "${components_json}" jhbasePins utf8proc directory)
if(error)
  jh_fail("config/tooling/managed_components.json has no jhbasePins.utf8proc.directory")
endif()
get_filename_component(utf8proc_dir "${dependency_root}/${utf8proc_rel}" ABSOLUTE)
jb_check_git_dependency("${utf8proc_dir}" "${utf8proc_repo}" "${utf8proc_ref}" error)
if(NOT error STREQUAL "")
  jh_fail("${error}. Run scripts/ensure_utf8proc.sh")
endif()

jh_read_pin("${JH_ROOT}/third_party/pcre2_version.conf" PCRE2 pcre2_repo pcre2_ref pcre2_rel)
if(pcre2_rel STREQUAL "")
  jh_fail("PCRE2_DIR is missing from third_party/pcre2_version.conf")
endif()
get_filename_component(pcre2_dir "${dependency_root}/${pcre2_rel}" ABSOLUTE)
# The same verification the tool's configure repeats, including the empty
# gitlink of the unused JIT sources.
set(JH_VERIFY_JHBASE_DIR "${jhbase_dir}")
set(ENV{JH_DEPENDENCY_ROOT} "${dependency_root}")
include("${JH_ROOT}/cmake/jh_verify_pcre2.cmake")

# ---------------------------------------------------------------------------
# Inputs of the tool build and the key
file(GLOB_RECURSE tool_files LIST_DIRECTORIES FALSE RELATIVE "${JH_ROOT}" "${JH_ROOT}/tools/jh/*")
# Documentation beside the sources is not an input of the build.
list(FILTER tool_files EXCLUDE REGEX "\\.md$")
list(APPEND tool_files
  cmake/jh_jhbase.cmake cmake/jh_pcre2.cmake cmake/jh_verify_pcre2.cmake
  cmake/jh_build_dir_guard.cmake third_party/jhbase_version.conf
  third_party/pcre2_version.conf config/tooling/managed_components.json
  scripts/jh_bootstrap.cmake)
list(SORT tool_files)
list(REMOVE_DUPLICATES tool_files)
set(inputs "")
set(input_entries "")
foreach(path IN LISTS tool_files)
  if(NOT EXISTS "${JH_ROOT}/${path}")
    jh_fail("Tool build input is missing: ${path}")
  endif()
  file(SHA256 "${JH_ROOT}/${path}" sha)
  string(APPEND inputs "${sha}  ${path}\n")
  list(APPEND input_entries "${sha}  ${path}")
endforeach()
set(host_text "os=${os}\nvariant=${variant}\ncompiler=${compiler_identity}\n")
string(APPEND host_text "generator=${JH_GENERATOR}\nplatform=${platform}\n")
string(APPEND host_text "buildType=${JH_BUILD_TYPE}\ncmake=${CMAKE_VERSION}\n")
set(deps_text "jhbase ${jhbase_key}\nutf8proc ${utf8proc_ref}\npcre2 ${pcre2_ref}\n")
string(SHA256 full_key "${host_text}${deps_text}${inputs}")
string(SUBSTRING "${full_key}" 0 24 key)
set(key_dir "${JH_OUTPUT_ROOT}/${variant}/${key}")
set(exe "${key_dir}/bin/${exe_name}")

# ---------------------------------------------------------------------------
# Reuse or build under the key's lock
file(MAKE_DIRECTORY "${key_dir}")
file(LOCK "${key_dir}/lock" GUARD PROCESS TIMEOUT 1800 RESULT_VARIABLE lock_status)
if(NOT lock_status EQUAL 0)
  jh_fail("Cannot lock ${key_dir}: ${lock_status}")
endif()
jh_published_ok("${key_dir}" "${key}" "${exe_name}" reusable)
if(NOT reusable)
  set(work "${key_dir}/work")
  set(marker "${key_dir}/work.inprogress")
  if(EXISTS "${marker}" OR (EXISTS "${work}" AND NOT EXISTS "${work}/CMakeCache.txt"))
    # An interrupted build left this tree; start it again from nothing.
    file(REMOVE_RECURSE "${work}")
  endif()
  file(WRITE "${marker}" "${key}\n")
  set(configure_arguments -S "${JH_ROOT}/tools/jh" -B "${work}" -G "${JH_GENERATOR}"
    "-DCMAKE_BUILD_TYPE=${JH_BUILD_TYPE}" -DBUILD_TESTING=OFF)
  if(NOT platform STREQUAL "")
    list(APPEND configure_arguments -A "${platform}")
  endif()
  if(NOT compiler_c STREQUAL "")
    list(APPEND configure_arguments "-DCMAKE_C_COMPILER=${compiler_c}"
      "-DCMAKE_CXX_COMPILER=${compiler_cxx}")
  endif()
  # The host tool never inherits a firmware toolchain or its flags.
  set(environment --unset=CC --unset=CXX --unset=CFLAGS --unset=CXXFLAGS --unset=LDFLAGS
    --unset=CMAKE_TOOLCHAIN_FILE "JH_DEPENDENCY_ROOT=${dependency_root}")
  if(jhbase_external)
    list(APPEND environment "JH_JHBASE_DIR=${jhbase_dir}")
  else()
    list(APPEND environment --unset=JH_JHBASE_DIR)
  endif()
  message(STATUS "[jh-bootstrap] Building jh ${variant} ${key} with ${JH_GENERATOR}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${environment}
      "${CMAKE_COMMAND}" ${configure_arguments}
    RESULT_VARIABLE rc OUTPUT_FILE "${key_dir}/configure.log" ERROR_FILE "${key_dir}/configure.log")
  if(NOT rc EQUAL 0)
    jh_fail("Configuring tools/jh failed; see ${key_dir}/configure.log")
  endif()
  set(build_arguments --build "${work}" --config "${JH_BUILD_TYPE}" --target jh --parallel)
  if(DEFINED JH_JOBS AND NOT JH_JOBS STREQUAL "")
    list(APPEND build_arguments "${JH_JOBS}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${environment} "${CMAKE_COMMAND}" ${build_arguments}
    RESULT_VARIABLE rc OUTPUT_FILE "${key_dir}/build.log" ERROR_FILE "${key_dir}/build.log")
  if(NOT rc EQUAL 0)
    jh_fail("Building tools/jh failed; see ${key_dir}/build.log")
  endif()
  # What the configured compiler really is, and that it matches the variant.
  jh_read_compiler_info("${work}" pointer_size cache_compiler cache_compiler_id cache_compiler_version)
  if(NOT pointer_size STREQUAL "${expected_pointer_size}")
    jh_fail("The configured compiler builds ${pointer_size}-byte pointers; variant ${variant} needs ${expected_pointer_size}")
  endif()
  if(JH_GENERATOR MATCHES "^Visual Studio")
    set(built "${work}/${JH_BUILD_TYPE}/${exe_name}")
  else()
    set(built "${work}/${exe_name}")
  endif()
  if(NOT EXISTS "${built}")
    jh_fail("The build produced no ${built}")
  endif()
  execute_process(COMMAND "${built}" --version --json RESULT_VARIABLE rc OUTPUT_VARIABLE probe ERROR_QUIET)
  if(NOT rc EQUAL 0 OR NOT probe MATCHES "\"status\":\"HAL_OK\"")
    jh_fail("The built ${built} does not run on this host (exit ${rc})")
  endif()
  # Publish the executable and its manifest together, after the build.
  set(stage "${key_dir}/stage")
  file(REMOVE_RECURSE "${stage}")
  file(COPY "${built}" DESTINATION "${stage}")
  file(SHA256 "${stage}/${exe_name}" exe_sha)
  set(manifest "{}")
  string(JSON manifest SET "${manifest}" formatVersion 1)
  foreach(field "key;${key}" "variant;${variant}" "os;${os}" "root;${JH_ROOT}"
      "dependencyRoot;${dependency_root}" "generator;${JH_GENERATOR}" "platform;${platform}"
      "buildType;${JH_BUILD_TYPE}" "cmake;${CMAKE_VERSION}")
    list(GET field 0 name)
    list(LENGTH field length)
    set(value "")
    if(length GREATER 1)
      list(GET field 1 value)
    endif()
    jh_json_quote(quoted "${value}")
    string(JSON manifest SET "${manifest}" "${name}" "${quoted}")
  endforeach()
  string(JSON manifest SET "${manifest}" pointerSize "${pointer_size}")
  string(JSON manifest SET "${manifest}" compiler "{}")
  jh_json_quote(quoted "${cache_compiler_id}")
  string(JSON manifest SET "${manifest}" compiler id "${quoted}")
  jh_json_quote(quoted "${cache_compiler_version}")
  string(JSON manifest SET "${manifest}" compiler version "${quoted}")
  jh_json_quote(quoted "${cache_compiler}")
  string(JSON manifest SET "${manifest}" compiler path "${quoted}")
  jh_json_quote(quoted "${compiler_identity}")
  string(JSON manifest SET "${manifest}" compiler identity "${quoted}")
  string(JSON manifest SET "${manifest}" dependencies "{}")
  foreach(dependency "jhbase;${jhbase_dir};${jhbase_revision}" "utf8proc;${utf8proc_dir};${utf8proc_ref}"
      "pcre2;${pcre2_dir};${pcre2_ref}")
    list(GET dependency 0 name)
    list(GET dependency 1 path)
    list(GET dependency 2 revision)
    string(JSON manifest SET "${manifest}" dependencies "${name}" "{}")
    jh_json_quote(quoted "${path}")
    string(JSON manifest SET "${manifest}" dependencies "${name}" path "${quoted}")
    jh_json_quote(quoted "${revision}")
    string(JSON manifest SET "${manifest}" dependencies "${name}" revision "${quoted}")
  endforeach()
  string(JSON manifest SET "${manifest}" inputs "[]")
  set(index 0)
  foreach(entry IN LISTS input_entries)
    jh_json_quote(quoted "${entry}")
    string(JSON manifest SET "${manifest}" inputs "${index}" "${quoted}")
    math(EXPR index "${index} + 1")
  endforeach()
  string(JSON manifest SET "${manifest}" executable "{}")
  jh_json_quote(quoted "${exe}")
  string(JSON manifest SET "${manifest}" executable path "${quoted}")
  jh_json_quote(quoted "${exe_sha}")
  string(JSON manifest SET "${manifest}" executable sha256 "${quoted}")
  file(WRITE "${stage}/manifest.json" "${manifest}\n")
  file(REMOVE_RECURSE "${key_dir}/bin")
  file(RENAME "${stage}" "${key_dir}/bin")
  file(REMOVE "${marker}")
  jh_published_ok("${key_dir}" "${key}" "${exe_name}" reusable)
  if(NOT reusable)
    jh_fail("The published ${exe} does not match its manifest")
  endif()
endif()
file(LOCK "${key_dir}/lock" RELEASE)
if(DEFINED JH_RESULT_FILE AND NOT JH_RESULT_FILE STREQUAL "")
  file(WRITE "${JH_RESULT_FILE}" "${exe}\n")
else()
  message(STATUS "[jh-bootstrap] ${exe}")
endif()
