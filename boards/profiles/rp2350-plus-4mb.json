{
  "$schema": "../board.schema.json",
  "schemaVersion": 1,
  "kind": "board",
  "id": "rp2350-plus-4mb",
  "displayName": "Waveshare RP2350-Plus 4 MB",
  "description": "RP2350-Plus board with an exact 4 MB flash variant; same header layout as the RP2040-Plus.",
  "status": "supported",
  "compatibleTargets": ["rp2350-arm", "rp2350-riscv"],
  "build": { "provider": "pico-sdk", "board": "waveshare_rp2350_plus_4mb" },
  "hal": { "profileId": 16, "selector": "HAL_BOARD_PROFILE_RP2350_PLUS_4MB", "legacySelectors": [], "autoDetectSelectors": [] },
  "memory": { "flash": { "source": "sdk", "expectedBytes": 4194304 } },
  "gpio": {
    "exposedPins": { "ranges": [{ "first": 0, "last": 22 }, { "first": 26, "last": 29 }] },
    "reservations": { "status-led": { "pins": [{ "domain": "soc-gpio", "id": 25 }], "owner": "board.status-led", "strength": "soft", "reason": "On-board GPIO status LED." } },
    "aliases": { "status-led": { "endpoint": { "domain": "soc-gpio", "id": 25 } } }
  },
  "clockSources": { "xosc": { "kind": "crystal", "frequencyHz": 12000000, "pins": [] } },
  "capabilities": { "usb-device": { "present": true }, "cyw43": { "present": false }, "native-wifi": { "present": false }, "external-radio-frontend": { "present": false }, "bluetooth-controller": { "present": false }, "bluetooth-le-controller": { "present": false }, "bluetooth-classic-controller": { "present": false }, "sx1262-radio": { "present": false } },
  "devices": { "statusLed": { "kind": "gpio", "endpoint": { "domain": "soc-gpio", "id": 25 }, "activeLevel": "high" } },
  "peripherals": { "defaultsSource": "pico-sdk" },
  "components": {}
}
