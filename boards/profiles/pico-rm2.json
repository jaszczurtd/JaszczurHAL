{
  "$schema": "../board.schema.json",
  "schemaVersion": 1,
  "kind": "board",
  "id": "pico-rm2",
  "displayName": "Raspberry Pi Pico with PIM730/RM2",
  "description": "RP2040 Pico with a fixed external CYW43 radio frontend.",
  "status": "experimental",
  "compatibleTargets": ["rp2040"],
  "build": { "provider": "pico-sdk", "board": "pico" },
  "hal": { "profileId": 5, "selector": "HAL_BOARD_PROFILE_RP_PICO_PIM730", "legacySelectors": ["HAL_CYW43_PROFILE_PIM730"], "autoDetectSelectors": [] },
  "memory": { "flash": { "source": "sdk", "expectedBytes": 2097152 } },
  "gpio": {
    "exposedPins": { "ranges": [{ "first": 0, "last": 22 }, { "first": 26, "last": 28 }] },
    "reservations": {
      "smps-mode": { "pins": [{ "domain": "soc-gpio", "id": 23 }], "owner": "power.smps", "strength": "hard", "reason": "On-board SMPS mode control." },
      "vbus-sense": { "pins": [{ "domain": "soc-gpio", "id": 24 }], "owner": "power.vbus-sense", "strength": "hard", "reason": "On-board VBUS sensing." },
      "status-led": { "pins": [{ "domain": "soc-gpio", "id": 25 }], "owner": "board.status-led", "strength": "soft", "reason": "On-board GPIO status LED." },
      "vsys-sense": { "pins": [{ "domain": "soc-gpio", "id": 29 }], "owner": "power.vsys-sense", "strength": "hard", "reason": "On-board VSYS ADC sensing." },
      "cyw43-bus": { "pins": [{ "domain": "soc-gpio", "id": 2 }, { "domain": "soc-gpio", "id": 3 }, { "domain": "soc-gpio", "id": 4 }, { "domain": "soc-gpio", "id": 5 }, { "domain": "soc-gpio", "id": 6 }], "owner": "radio.cyw43", "strength": "hard", "reason": "Fixed PIM730/RM2 transport." }
    },
    "aliases": { "status-led": { "endpoint": { "domain": "soc-gpio", "id": 25 } } }
  },
  "capabilities": { "usb-device": { "present": true }, "cyw43": { "present": true }, "native-wifi": { "present": false }, "external-radio-frontend": { "present": true }, "bluetooth-controller": { "present": true }, "sx1262-radio": { "present": false } },
  "devices": { "statusLed": { "kind": "gpio", "endpoint": { "domain": "soc-gpio", "id": 25 }, "activeLevel": "high" } },
  "peripherals": { "defaultsSource": "pico-sdk" },
  "components": { "cyw43-pico-pio": { "mode": "board-owned" }, "cyw43-lwip": { "mode": "feature-gated" }, "btstack-host": { "mode": "feature-gated" } }
}
