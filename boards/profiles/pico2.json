{
  "$schema": "../board.schema.json",
  "schemaVersion": 1,
  "kind": "board",
  "id": "pico2",
  "displayName": "Raspberry Pi Pico 2",
  "description": "RP2350 board with 4 MB flash and a GPIO status LED.",
  "status": "supported",
  "compatibleTargets": ["rp2350-arm", "rp2350-riscv"],
  "build": { "provider": "pico-sdk", "board": "pico2" },
  "hal": { "profileId": 3, "selector": "HAL_BOARD_PROFILE_RP_PICO_2", "runtimeName": "pico2", "legacySelectors": [] },
  "memory": { "flash": { "source": "sdk", "expectedBytes": 4194304 } },
  "gpio": {
    "exposedPins": { "ranges": [{ "first": 0, "last": 22 }, { "first": 26, "last": 28 }] },
    "reservations": { "status-led": { "pins": [{ "domain": "soc-gpio", "id": 25 }], "owner": "board.status-led", "strength": "soft", "reason": "On-board GPIO status LED." } },
    "aliases": { "status-led": { "endpoint": { "domain": "soc-gpio", "id": 25 } } }
  },
  "capabilities": { "usb-device": { "present": true }, "cyw43": { "present": false }, "external-radio-frontend": { "present": false } },
  "devices": { "statusLed": { "kind": "gpio", "endpoint": { "domain": "soc-gpio", "id": 25 }, "activeLevel": "high" } },
  "peripherals": { "defaultsSource": "pico-sdk" },
  "components": {}
}
