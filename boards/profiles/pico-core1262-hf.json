{
  "$schema": "../board.schema.json",
  "schemaVersion": 1,
  "kind": "board",
  "id": "pico-core1262-hf",
  "displayName": "Raspberry Pi Pico with Core1262-HF",
  "description": "Raspberry Pi Pico with an external Waveshare Core1262-HF (SKU 20855) using the project fixture wiring.",
  "status": "experimental",
  "compatibleTargets": ["rp2040"],
  "build": { "provider": "pico-sdk", "board": "pico" },
  "hal": { "profileId": 12, "selector": "HAL_BOARD_PROFILE_RP_PICO_CORE1262_HF", "legacySelectors": [], "autoDetectSelectors": [] },
  "memory": { "flash": { "source": "sdk", "expectedBytes": 2097152 } },
  "gpio": {
    "exposedPins": { "ranges": [{ "first": 0, "last": 22 }, { "first": 26, "last": 28 }] },
    "reservations": {
      "smps-mode": { "pins": [{ "domain": "soc-gpio", "id": 23 }], "owner": "power.smps", "strength": "hard", "reason": "On-board SMPS mode control." },
      "vbus-sense": { "pins": [{ "domain": "soc-gpio", "id": 24 }], "owner": "power.vbus-sense", "strength": "hard", "reason": "On-board VBUS sensing." },
      "status-led": { "pins": [{ "domain": "soc-gpio", "id": 25 }], "owner": "board.status-led", "strength": "soft", "reason": "On-board GPIO status LED." },
      "vsys-sense": { "pins": [{ "domain": "soc-gpio", "id": 29 }], "owner": "power.vsys-sense", "strength": "hard", "reason": "On-board VSYS ADC sensing." },
      "lora-radio": { "pins": [{ "domain": "soc-gpio", "id": 10 }, { "domain": "soc-gpio", "id": 11 }, { "domain": "soc-gpio", "id": 16 }, { "domain": "soc-gpio", "id": 17 }, { "domain": "soc-gpio", "id": 18 }, { "domain": "soc-gpio", "id": 19 }, { "domain": "soc-gpio", "id": 20 }, { "domain": "soc-gpio", "id": 21 }, { "domain": "soc-gpio", "id": 22 }], "owner": "board.lora-radio", "strength": "hard", "reason": "Frozen SPI, control, IRQ, and RF-switch wiring of the external Core1262-HF fixture." }
    },
    "aliases": { "status-led": { "endpoint": { "domain": "soc-gpio", "id": 25 } } }
  },
  "capabilities": { "usb-device": { "present": true }, "cyw43": { "present": false }, "native-wifi": { "present": false }, "external-radio-frontend": { "present": true }, "bluetooth-controller": { "present": false }, "bluetooth-le-controller": { "present": false }, "bluetooth-classic-controller": { "present": false }, "sx1262-radio": { "present": true } },
  "devices": {
    "statusLed": { "kind": "gpio", "endpoint": { "domain": "soc-gpio", "id": 25 }, "activeLevel": "high" },
    "loraRadio": {
      "kind": "bus-device",
      "role": "sx1262-radio",
      "bus": { "kind": "spi", "index": 0 },
      "signals": {
        "sck": { "domain": "soc-gpio", "id": 18 },
        "mosi": { "domain": "soc-gpio", "id": 19 },
        "miso": { "domain": "soc-gpio", "id": 16 },
        "cs": { "domain": "soc-gpio", "id": 17 },
        "reset": { "domain": "soc-gpio", "id": 20 },
        "busy": { "domain": "soc-gpio", "id": 21 },
        "dio1": { "domain": "soc-gpio", "id": 22 },
        "rfSwitchA": { "domain": "soc-gpio", "id": 10 },
        "rfSwitchB": { "domain": "soc-gpio", "id": 11 }
      },
      "attributes": {
        "minFrequencyHz": 850000000,
        "maxFrequencyHz": 930000000,
        "maxSpiClockHz": 18000000,
        "defaultSpiClockHz": 8000000,
        "minTxPowerDbm": -9,
        "maxTxPowerDbm": 22,
        "regulator": "dcdc",
        "rfSwitchMode": "dual-gpio",
        "rfSwitchIdleLevelA": false,
        "rfSwitchRxLevelA": false,
        "rfSwitchTxLevelA": true,
        "rfSwitchIdleLevelB": false,
        "rfSwitchRxLevelB": true,
        "rfSwitchTxLevelB": false,
        "tcxoControl": "dio3",
        "tcxoVoltage": "1v8",
        "tcxoStartupUs": 5000
      }
    }
  },
  "peripherals": { "defaultsSource": "pico-sdk" },
  "components": { "sx126x-radio": { "mode": "feature-gated" } }
}
