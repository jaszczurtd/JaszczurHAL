    "HAL_ENABLE_PULSE_CAPTURE",
    "HAL_ENABLE_PWM_FREQ",
    "HAL_ENABLE_RGB_LED",
    "HAL_ENABLE_RTC",
    "HAL_ENABLE_SERIAL_COMMANDS",
    "HAL_ENABLE_SPI",
    "HAL_ENABLE_SSD1306",
    "HAL_ENABLE_SSD1331",
    "HAL_ENABLE_SSD135X",
    "HAL_ENABLE_SSD16XX",
    "HAL_ENABLE_ST7567",
