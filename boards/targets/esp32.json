{
  "$schema": "../board.schema.json",
  "schemaVersion": 1,
  "kind": "target",
  "id": "esp32",
  "displayName": "Espressif ESP32",
  "description": "Dual-core Xtensa LX6 target with Bluetooth Classic, built with the pinned ESP-IDF.",
  "status": "experimental",
  "architecture": {
    "vendor": "espressif",
    "family": "esp32",
    "soc": "esp32",
    "isa": "xtensa-lx6",
    "cores": 2,
    "mcuName": "ESP32",
    "mcuSubtype": "ESP32",
    "cpuArchName": "Xtensa LX6",
    "hasFpu": true,
    "backendName": "esp-idf"
  },
  "hal": { "targetSelector": "HAL_TARGET_ESP32" },
  "build": { "provider": "esp-idf", "recipe": "esp-idf-native", "idfTarget": "esp32" },
  "gpio": {
    "pinIdFormat": "integer",
    "validPins": { "ranges": [{ "first": 0, "last": 19 }, { "first": 21, "last": 23 }, { "first": 25, "last": 27 }, { "first": 32, "last": 39 }] },
    "halEncoding": { "kind": "identity-u8" },
    "traits": {
      "adc": { "values": [0, 2, 4, 12, 13, 14, 15, 25, 26, 27, 32, 33, 34, 35, 36, 37, 38, 39] },
      "input-only": { "ranges": [{ "first": 34, "last": 39 }] },
      "rtc": { "values": [0, 2, 4, 12, 13, 14, 15, 25, 26, 27, 32, 33, 34, 35, 36, 37, 38, 39] },
      "strapping": { "values": [0, 2, 5, 12, 15] },
      "touch": { "values": [0, 2, 4, 12, 13, 14, 15, 27, 32, 33] }
    }
  },
  "memory": {
    "regions": {
      "internal-sram": { "kind": "ram", "sizeBytes": 532480, "dmaCapable": true }
    },
    "ramUsableBytes": 532480,
    "externalRam": { "interfaces": ["quad"], "maxBytes": 4194304 }
  },
  "defaultBoard": "esp32-devkitc-v4",
  "components": { "esp-idf-native": { "mode": "required" } },
  "requiredFeatures": ["HAL_ENABLE_FREERTOS"],
  "supportedFeatures": [
    "HAL_ENABLE_BLUETOOTH_CLASSIC",
    "HAL_ENABLE_BLUETOOTH_HID_HOST",
    "HAL_ENABLE_BLUETOOTH_GAMEPAD",
    "HAL_ENABLE_CRC",
    "HAL_ENABLE_FREERTOS"
  ]
}
