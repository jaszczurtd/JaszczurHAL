{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JaszczurHAL target or board descriptor",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "displayName", "description", "status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["target", "board"] },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string" },
    "description": { "type": "string" },
    "status": { "enum": ["supported", "experimental", "skeleton", "deprecated"] }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "target" } } },
      "then": {
        "required": ["architecture", "memory"],
        "properties": {
          "architecture": {
            "type": "object",
            "required": ["vendor", "family", "soc", "isa", "cores", "mcuName", "mcuSubtype", "cpuArchName", "hasFpu", "backendName"],
            "properties": {
              "vendor": { "type": "string", "minLength": 1 },
              "family": { "type": "string", "minLength": 1 },
              "soc": { "type": "string", "minLength": 1 },
              "isa": { "type": "string", "minLength": 1 },
              "cores": { "type": "integer", "minimum": 1 },
              "mcuName": { "type": "string", "minLength": 1 },
              "mcuSubtype": { "type": "string", "minLength": 1 },
              "cpuArchName": { "type": "string", "minLength": 1 },
              "hasFpu": { "type": "boolean" },
              "backendName": { "type": "string", "minLength": 1 }
            }
          },
          "memory": {
            "type": "object",
            "required": ["regions", "ramUsableBytes"],
            "properties": {
              "regions": { "type": "object" },
              "ramUsableBytes": { "type": "integer", "minimum": 0 },
              "externalRam": {
                "type": "object",
                "required": ["interfaces", "maxBytes"],
                "properties": {
                  "interfaces": {
                    "type": "array",
                    "items": { "enum": ["quad", "octal"] },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "maxBytes": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "requiredFeatures": {
            "type": "array",
            "items": { "type": "string", "pattern": "^HAL_(ENABLE|DISABLE)_[A-Z0-9_]+$" },
            "uniqueItems": true
          },
          "supportedFeatures": {
            "type": "array",
            "items": { "type": "string", "pattern": "^HAL_ENABLE_[A-Z0-9_]+$" },
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "board" } } },
      "then": {
        "properties": {
          "programming": {
            "type": "object",
            "required": ["transport", "usb", "reset", "boot"],
            "properties": {
              "transport": { "const": "usb-serial-jtag" },
              "usb": {
                "type": "object",
                "required": ["vid", "pid"],
                "properties": {
                  "vid": { "type": "integer", "minimum": 0, "maximum": 65535 },
                  "pid": { "type": "integer", "minimum": 0, "maximum": 65535 }
                },
                "additionalProperties": false
              },
              "reset": { "const": "usb-serial-jtag-control-lines" },
              "boot": { "const": "usb-serial-jtag-control-lines" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
