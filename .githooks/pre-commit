#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

hook_python="${JH_COMPONENT_PYTHON:-${JH_VSCODE_PYTHON:-}}"
if [ -z "$hook_python" ]; then
    hook_python=python3
    if [ "${OS:-}" = Windows_NT ] &&
            [ -f "$repo_root/.build/windows/venv/Scripts/python.exe" ]; then
        hook_python="$repo_root/.build/windows/venv/Scripts/python.exe"
    fi
fi

# Git passes GIT_INDEX_FILE relative to the top of the work tree for a plain
# commit (an absolute temporary index for a commit naming paths); make it
# absolute for the generators below, which run in another directory. Git for
# Windows passes absolute paths with a drive letter.
case "${GIT_INDEX_FILE:-}" in
    "" | /* | [A-Za-z]:[\\/]*) ;;
    *)
        GIT_INDEX_FILE="$repo_root/$GIT_INDEX_FILE"
        export GIT_INDEX_FILE
        ;;
esac

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

fix_text_file() {
    file="$1"

    # Skip deleted or non-regular files.
    [ -f "$file" ] || return 0

    # Skip binary files.
    if ! grep -Iq . "$file"; then
        return 0
    fi

    # 1) Normalize CRLF to LF.
    perl -i -pe 's/\r$//' "$file"

    # 2) Remove trailing horizontal whitespace.
    sed -i 's/[[:blank:]]\+$//' "$file"

    # 3) Ensure trailing newline at EOF.
    if [ -s "$file" ] && [ "$(tail -c 1 "$file" | wc -l)" -eq 0 ]; then
        printf '\n' >> "$file"
    fi

    # 4) Replace problematic UTF-8 punctuation with ASCII equivalents.
    # Use byte sequences so this works even when Perl does not decode input
    # as UTF-8 by default.
    # NBSP -> space
    # Left/Right single quote -> '
    # Left/Right double quote -> "
    # En dash/Em dash -> -
    # Right arrow -> ->
    # Ellipsis -> ...
    perl -i -pe 's/\xC2\xA0/ /g; s/\xE2\x80[\x98\x99]/\x27/g; s/\xE2\x80[\x9C\x9D]/\x22/g; s/\xE2\x80[\x93\x94]/-/g; s/\xE2\x86\x92/->/g; s/\xE2\x80\xA6/.../g' "$file"
}

format_cpp_file() {
    file="$1"
    [ -f "$file" ] || return 0

    case "$file" in
        src/hal/generated/jh_hal_features.h|\
        src/hal/generated/jh_board_registry.h|\
        src/hal/generated/jh_board_fallback_config.h|\
        src/hal/generated/jh_device_defaults.h)
            # Generated artifacts must remain byte-for-byte identical to the
            # generator output verified by the corresponding --check command.
            return 0
            ;;
        *.c|*.cc|*.cpp|*.cxx|*.h|*.hh|*.hpp|*.hxx)
            if command -v clang-format >/dev/null 2>&1; then
                clang-format -i "$file"
            fi
            ;;
        *)
            ;;
    esac
}

if [ -n "$staged_files" ]; then
    echo "[pre-commit] Normalizing staged files..."
    echo "$staged_files" | while IFS= read -r file; do
        [ -n "$file" ] || continue
        fix_text_file "$file"
        format_cpp_file "$file"
        git add -- "$file"
    done
fi

# After formatting, on the staged tree rather than the working tree, so the
# generators read exactly the files the commit records. Their refreshed output
# joins the commit. A working copy holding a third version of such a file, or
# a commit naming paths (a temporary index), blocks the commit instead.
echo "[pre-commit] Refreshing generated artifacts..."
# The index snapshot holds no managed checkouts (third_party is ignored by
# Git): the generators take them from this checkout through
# JH_DEPENDENCY_ROOT, verified against the snapshot's own pins, and the jh
# bootstrap publishes below this checkout's .build, so the snapshot reuses
# the tool built for the same inputs instead of building into a directory
# this hook removes.
JH_DEPENDENCY_ROOT="${JH_DEPENDENCY_ROOT:-$repo_root}"
JH_OUTPUT_ROOT="${JH_OUTPUT_ROOT:-$repo_root/.build/host-tools}"
export JH_DEPENDENCY_ROOT JH_OUTPUT_ROOT
staged_tree="$repo_root/.build/pre-commit/staged"
report="$repo_root/.build/pre-commit/generated.txt"
rm -rf "$staged_tree" "$report"
mkdir -p "$staged_tree"
git checkout-index --all --prefix="$staged_tree/"

blocked() {
    rm -rf "$staged_tree" "$report"
    echo >&2
    echo "[pre-commit] Commit blocked: $1" >&2
    echo "[pre-commit] Refresh the generated artifacts with:" >&2
    printf '%s\n' "  \"$hook_python\" scripts/sync_generated.py --write" >&2
    echo "[pre-commit] Review and stage the generated changes, then retry the commit." >&2
    exit 1
}

if ! GIT_DIR="$(git rev-parse --absolute-git-dir)" GIT_WORK_TREE="$staged_tree" \
        PYTHONDONTWRITEBYTECODE=1 \
        "$hook_python" "$staged_tree/scripts/sync_generated.py" --write --report-file "$report"; then
    blocked "generated artifacts are missing or stale and could not be refreshed."
fi
# The report also lists files whose mode alone changed in the export; only
# content that differs from the index needs staging.
refreshed=""
while IFS= read -r file; do
    [ -n "$file" ] || continue
    if [ -f "$staged_tree/$file" ] &&
            [ "$(git hash-object --path="$file" "$staged_tree/$file")" = \
              "$(git rev-parse -q --verify ":$file" || true)" ]; then
        continue
    fi
    refreshed="$refreshed$file
"
done <<REPORT
$(sed -n 's/^  - //p' "$report")
REPORT
if [ -n "$refreshed" ]; then
    # Files staged in the temporary index of a commit naming paths would not
    # reach the real index after the commit.
    real_index="$(env -u GIT_INDEX_FILE git rev-parse --path-format=absolute --git-path index)"
    case "${GIT_INDEX_FILE:-$real_index}" in
        "$real_index" | "$real_index.lock") ;;
        *) blocked "generated artifacts are stale; a commit naming paths cannot take them." ;;
    esac
    # Check every file before touching any: only a working copy equal to its
    # staged version, or already equal to the fresh output, is replaced.
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        [ -f "$staged_tree/$file" ] ||
            blocked "a generator removed $file; remove it from the commit yourself."
        if [ -e "$file" ] && ! cmp -s "$staged_tree/$file" "$file"; then
            if ! git ls-files --error-unmatch -- "$file" >/dev/null 2>&1 ||
                    ! git diff --quiet -- "$file"; then
                blocked "$file has unstaged changes that differ from the generated output."
            fi
        fi
    done <<REFRESHED
$refreshed
REFRESHED
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        mkdir -p "$(dirname "$file")"
        cat "$staged_tree/$file" > "$file"
        git add -- "$file"
        echo "[pre-commit] Refreshed and staged $file"
    done <<REFRESHED
$refreshed
REFRESHED
fi
rm -rf "$staged_tree" "$report"

echo "[pre-commit] Done."
