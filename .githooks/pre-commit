#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Git passes GIT_INDEX_FILE relative to the top of the work tree for a plain
# commit (an absolute temporary index for a commit naming paths); make it
# absolute for the generator check below, which runs in another directory.
case "${GIT_INDEX_FILE:-}" in
    "" | /*) ;;
    *)
        GIT_INDEX_FILE="$repo_root/$GIT_INDEX_FILE"
        export GIT_INDEX_FILE
        ;;
esac

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

fix_text_file() {
    file="$1"

    # Skip deleted or non-regular files.
    [ -f "$file" ] || return 0

    # Skip binary files.
    if ! grep -Iq . "$file"; then
        return 0
    fi

    # 1) Normalize CRLF to LF.
    perl -i -pe 's/\r$//' "$file"

    # 2) Remove trailing horizontal whitespace.
    sed -i 's/[[:blank:]]\+$//' "$file"

    # 3) Ensure trailing newline at EOF.
    if [ -s "$file" ] && [ "$(tail -c 1 "$file" | wc -l)" -eq 0 ]; then
        printf '\n' >> "$file"
    fi

    # 4) Replace problematic UTF-8 punctuation with ASCII equivalents.
    # Use byte sequences so this works even when Perl does not decode input
    # as UTF-8 by default.
    # NBSP -> space
    # Left/Right single quote -> '
    # Left/Right double quote -> "
    # En dash/Em dash -> -
    # Right arrow -> ->
    # Ellipsis -> ...
    perl -i -pe 's/\xC2\xA0/ /g; s/\xE2\x80[\x98\x99]/\x27/g; s/\xE2\x80[\x9C\x9D]/\x22/g; s/\xE2\x80[\x93\x94]/-/g; s/\xE2\x86\x92/->/g; s/\xE2\x80\xA6/.../g' "$file"
}

format_cpp_file() {
    file="$1"
    [ -f "$file" ] || return 0

    case "$file" in
        src/hal/generated/jh_hal_features.h|\
        src/hal/generated/jh_board_registry.h|\
        src/hal/generated/jh_board_fallback_config.h|\
        src/hal/generated/jh_device_defaults.h)
            # Generated artifacts must remain byte-for-byte identical to the
            # generator output verified by the corresponding --check command.
            return 0
            ;;
        *.c|*.cc|*.cpp|*.cxx|*.h|*.hh|*.hpp|*.hxx)
            if command -v clang-format >/dev/null 2>&1; then
                clang-format -i "$file"
            fi
            ;;
        *)
            ;;
    esac
}

if [ -n "$staged_files" ]; then
    echo "[pre-commit] Normalizing staged files..."
    echo "$staged_files" | while IFS= read -r file; do
        [ -n "$file" ] || continue
        fix_text_file "$file"
        format_cpp_file "$file"
        git add -- "$file"
    done
fi

# After formatting, on the staged tree rather than the working tree, so the
# check reads exactly the files the commit records: a staged input whose
# regenerated output is left unstaged must not pass.
echo "[pre-commit] Checking generated artifacts..."
staged_tree="$repo_root/.build/pre-commit/staged"
rm -rf "$staged_tree"
mkdir -p "$staged_tree"
git checkout-index --all --prefix="$staged_tree/"
if ! GIT_DIR="$(git rev-parse --absolute-git-dir)" GIT_WORK_TREE="$staged_tree" \
        PYTHONDONTWRITEBYTECODE=1 \
        python3 "$staged_tree/scripts/sync_generated.py" --check; then
    rm -rf "$staged_tree"
    echo >&2
    echo "[pre-commit] Commit blocked: generated artifacts are missing or stale." >&2
    echo "[pre-commit] Refresh them with:" >&2
    echo "  python3 scripts/sync_generated.py --write" >&2
    echo "[pre-commit] Review and stage the generated changes, then retry the commit." >&2
    exit 1
fi
rm -rf "$staged_tree"

echo "[pre-commit] Done."
